function addDataLayer(type, json) {
    if (window.location.href.indexOf("Completed") <= 0) {
        var prods = [], bundles = [];
        if (type === "added") {

            if (JSON.parse(JSON.stringify(dataLayer)).indexOf(type) != -1) {

                for (var i = 0; i < dataLayer.length; i++) {
                    if (JSON.stringify(dataLayer[i]).indexOf(type) != -1 && JSON.stringify(dataLayer[i]).indexOf("addedbundle") == -1) {
                        if (dataLayer[i].added.length === undefined) {
                            prods.push(dataLayer[i].added);
                            dataLayer.splice(i, 1)
                        } else {
                            dataLayer[i].added.forEach(function (e) {
                                prods.push(e)
                            })
                            dataLayer.splice(i, 1)
                        }
                    }
                }
                prods = prods.concat(json);
                var prd = { added: prods };
                dataLayer.push(prd)
            } else {
                dataLayer.push({ added: json });
            }
        }

        else if (type === "addedbundle") {
            if (JSON.parse(JSON.stringify(dataLayer)).indexOf(type) != -1) {
                
                for (var i = 0; i < dataLayer.length; i++) {
                    if (JSON.stringify(dataLayer[i]).indexOf(type) != -1) {
                        if (dataLayer[i].addedbundle.length === undefined) {
                            prods.push(dataLayer[i].addedbundle);
                            dataLayer.splice(i, 1)
                        } else {
                            dataLayer[i].addedbundle.forEach(function (e) {
                                bundles.push(e)
                            })
                            dataLayer.splice(i, 1);
                        }
                    
                    }
                }
                bundles = bundles.concat(json);
                var bnd = { addedbundle: bundles };
                dataLayer.push(bnd);

            }
            else
            {
                dataLayer.push({ addedbundle: json });
            }

        }

        else
        {
            dataLayer.push(json)
        }
    }

}

function UpdateBasketItems(basketItems) {
    if (JSON.parse(JSON.stringify(dataLayer)).indexOf("BasketProducts") != -1) {
        for (var i = 0; i < dataLayer.length; i++) {
            var entry = dataLayer[i];
            if ( entry.BasketProducts && JSON.stringify(entry).indexOf("BasketProducts") != -1) {
                dataLayer.splice(i, 1);
                dataLayer.push(basketItems);
                break;
            }
        }
    } else {
        dataLayer.push(basketItems);
    }
}

function UpdatePageType(pageType) {
    if (JSON.parse(JSON.stringify(dataLayer)).indexOf("PageType") != -1) {
        for (var i = 0; i < dataLayer.length; i++) {
            var entry = dataLayer[i];
            if (entry.PageType && JSON.stringify(entry).indexOf("PageType") != -1) {
                dataLayer.splice(i, 1);
                dataLayer.push(pageType);
                break;
            }
        }
    } else {
        dataLayer.push(pageType);
    }
}

function UpdateProductDetayItem(product) {
    if (JSON.parse(JSON.stringify(dataLayer)).indexOf("ProductId") != -1) {
        for (var i = 0; i < dataLayer.length; i++) {
            var entry = dataLayer[i];
            if (entry.ProductId && JSON.stringify(entry).indexOf("ProductId") != -1) {
                dataLayer.splice(i, 1);
                dataLayer.push(product);
                break;
            }
        }
    } else {
        dataLayer.push(product);
    }
}

function RelatedEvent(event) {
    dataLayer.push(event)
} //RelatedEvent