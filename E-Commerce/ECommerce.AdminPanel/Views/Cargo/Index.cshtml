@model ECommerce.AdminPanel.Models.Cargo.CargoListViewModel
@{
    ViewData["Title"] = "Kargo Yönetimi";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title">Lojistik ve Kargo Ayarları</h1>
    
    
        <a asp-action="Create" class="btn btn-primary shadow-sm" style="background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%); border:none;">
            <i class="fas fa-truck-loading me-2"></i>Yeni Firma Ekle
        </a>
    
</div>

<div class="row g-4">
    @foreach (var cargo in Model.Cargoes)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 18px; transition: transform 0.2s;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                            <i class="fas fa-truck fa-2x"></i>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Aktif</span>
                    </div>
                    <h5 class="fw-bold mb-1">@cargo.Name</h5>
                    <p class="text-muted small mb-3">Sabit Gönderim Ücreti: <span class="text-dark fw-bold">@cargo.BasePrice.ToString("N2") ₺</span></p>
                    
                    <div class="bg-light p-2 rounded mb-3">
                        <code class="small text-truncate d-block">@cargo.TrackingUrlPrefix</code>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Update" asp-route-id="@cargo.Id" class="btn btn-sm btn-outline-primary flex-grow-1 border-0 bg-light">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@cargo.Id" method="post" onsubmit="return confirm('Bu kargo firmasını kaldırmak istediğinize emin misiniz?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger border-0 bg-light"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

