@model ECommerce.AdminPanel.Models.Cargo.UpdateCargoViewModel
@{
    ViewData["Title"] = "Kargo Firması Düzenle";
}

<div class="page-header mb-4">
    <h1 class="page-title">Kargo Firmasını Düzenle</h1>
    <p class="text-muted"><strong>@Model.Name</strong> bilgilerini güncelleyin.</p>


<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0" style="border-radius: 15px;">
            <div class="card-body p-4">
                <form asp-action="Update" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CompanyId" /> 
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Firma Adı</label>
                        <input asp-for="Name" class="form-control form-control-lg">
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BasePrice" class="form-label fw-bold">Sabit Gönderim Ücreti (₺)</label>
                        <input asp-for="BasePrice" type="number" step="0.01" class="form-control">
                        <span asp-validation-for="BasePrice" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TrackingUrlPrefix" class="form-label fw-bold">Takip URL Ön Eki</label>
                        <input asp-for="TrackingUrlPrefix" class="form-control">
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="Status">
                        <label class="form-check-label" asp-for="Status">Aktif Durum</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg" style="background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%); border:none;">
                            <i class="fas fa-save me-2"></i>Güncelle
                        </button>
                        <a asp-action="Index" class="btn btn-light btn-lg text-muted">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
