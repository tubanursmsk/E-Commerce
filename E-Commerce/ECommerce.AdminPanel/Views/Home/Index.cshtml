@model ECommerce.Application.DTOs.Dashboard.DashboardStatsDto
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="container-fluid p-0">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark">Genel Bakış</h1>
            <p class="text-muted mb-0">Hoşgeldiniz, işletmenizin anlık performans durumu.</p>
        </div>
        <div class="bg-white p-2 rounded shadow-sm border px-3">
            <i class="far fa-calendar-alt text-primary me-2"></i>
            <span class="fw-bold text-dark">@DateTime.Now.ToString("dd MMMM yyyy, dddd")</span>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 bg-white p-4 h-100 position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between position-relative" style="z-index: 2;">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold small">Aylık Ciro</h6>
                        <h2 class="mb-0 fw-bold text-primary">@Model.MonthlyTotalSales.ToString("N0") ₺</h2>
                        <span class="badge bg-success bg-opacity-10 text-success mt-2 rounded-pill px-2">
                            <i class="fas fa-arrow-up me-1"></i>%12 Artış
                        </span>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="fas fa-wallet fa-2x"></i>
                    </div>
                </div>
                <i class="fas fa-chart-line position-absolute bottom-0 start-0 text-primary" 
                   style="font-size: 6rem; opacity: 0.1; transform: translate(-20%, 20%); z-index: 0;"></i>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 bg-white p-4 h-100 position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between position-relative" style="z-index: 2;">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold small">Bekleyen Sipariş</h6>
                        <h2 class="mb-0 fw-bold text-warning">@Model.PendingOrdersCount</h2>
                        <span class="text-muted small mt-2 d-block">Kargolanmayı bekliyor</span>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="fas fa-box-open fa-2x"></i>
                    </div>
                </div>
                <i class="fas fa-clipboard-list position-absolute bottom-0 start-0 text-warning" 
                   style="font-size: 6rem; opacity: 0.1; transform: translate(-20%, 20%); z-index: 0;"></i>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 bg-white p-4 h-100 position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between position-relative" style="z-index: 2;">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold small">Müşteriler</h6>
                        <h2 class="mb-0 fw-bold text-info">@Model.TotalCustomersCount</h2>
                        <span class="badge bg-info bg-opacity-10 text-info mt-2 rounded-pill px-2">
                            <i class="fas fa-plus me-1"></i>Yeni Üyeler
                        </span>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
                <i class="fas fa-user-friends position-absolute bottom-0 start-0 text-info" 
                   style="font-size: 6rem; opacity: 0.1; transform: translate(-20%, 20%); z-index: 0;"></i>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 bg-white p-4 h-100 position-relative overflow-hidden">
                <div class="d-flex align-items-center justify-content-between position-relative" style="z-index: 2;">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold small">Kritik Stok</h6>
                        <h2 class="mb-0 fw-bold text-danger">@Model.CriticalStockCount</h2>
                        <span class="text-danger small mt-2 d-block fw-bold">Acil sipariş gerekli</span>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                        <i class="fas fa-exclamation-triangle fa-2x"></i>
                    </div>
                </div>
                <i class="fas fa-boxes position-absolute bottom-0 start-0 text-danger" 
                   style="font-size: 6rem; opacity: 0.1; transform: translate(-20%, 20%); z-index: 0;"></i>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 p-4 h-100" style="border-radius: 12px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold m-0 text-dark">Satış Analizi</h5>
                        <p class="text-muted small mb-0">En çok satan ürünlerin performansı</p>
                    </div>
                    <button class="btn btn-sm btn-light border"><i class="fas fa-download me-1"></i> PDF</button>
                </div>
                <div class="chart-container" style="position: relative; height:300px; width:100%">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="fw-bold m-0 text-primary"><i class="fas fa-bolt me-2"></i>Hızlı İşlemler</h6>
                </div>
                <div class="card-body pt-0">
                    <div class="d-grid gap-2">
                        <a asp-controller="Product" asp-action="Create" class="btn btn-primary text-start py-2 shadow-sm border-0">
                            <i class="fas fa-plus-circle me-2"></i> Yeni Ürün Ekle
                        </a>
                        <a asp-controller="Order" asp-action="Index" class="btn btn-light border text-start py-2 text-dark">
                            <i class="fas fa-clipboard-list me-2 text-secondary"></i> Siparişleri Yönet
                        </a>
                        <a asp-controller="Discount" asp-action="Create" class="btn btn-light border text-start py-2 text-dark">
                            <i class="fas fa-ticket-alt me-2 text-secondary"></i> Kupon Oluştur
                        </a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold m-0 text-dark">Son Hareketler</h6>
                    <a href="#" class="text-decoration-none small">Tümü</a>
                </div>
                <div class="card-body pt-0 px-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item border-0 d-flex align-items-center px-4 py-3">
                            <div class="bg-success bg-opacity-10 p-2 rounded-circle me-3 text-success">
                                <i class="fas fa-cart-plus"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0 small fw-bold">Yeni Sipariş #1024</h6>
                                <small class="text-muted" style="font-size: 0.75rem;">2 dk önce</small>
                            </div>
                            <span class="fw-bold text-dark small">+1.250 ₺</span>
                        </li>
                        <li class="list-group-item border-0 d-flex align-items-center px-4 py-3">
                            <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3 text-primary">
                                <i class="fas fa-user-plus"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0 small fw-bold">Yeni Üye Kaydı</h6>
                                <small class="text-muted" style="font-size: 0.75rem;">15 dk önce</small>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const productLabels = @Html.Raw(Json.Serialize(Model.TopProducts.Select(p => p.ProductName)));
        const productSales = @Html.Raw(Json.Serialize(Model.TopProducts.Select(p => p.TotalSold)));

        const ctx = document.getElementById('salesChart').getContext('2d');
        
        let gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(78, 115, 223, 0.5)'); 
        gradient.addColorStop(1, 'rgba(78, 115, 223, 0.01)'); 

        new Chart(ctx, {
            type: 'line', 
            data: {
                labels: productLabels.length > 0 ? productLabels : ["Veri Yok"],
                datasets: [{
                    label: 'Satış Adedi',
                    data: productSales.length > 0 ? productSales : [0],
                    backgroundColor: gradient,
                    borderColor: '#4e73df',
                    borderWidth: 2,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#4e73df',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }, 
                    tooltip: {
                        backgroundColor: '#fff',
                        titleColor: '#000',
                        bodyColor: '#000',
                        borderColor: '#e3e6f0',
                        borderWidth: 1,
                        padding: 10,
                        displayColors: false
                    }
                },
                scales: {
                    x: { grid: { display: false } }, 
                    y: { 
                        beginAtZero: true,
                        grid: { borderDash: [2, 4], color: "#e3e6f0" } 
                    }
                }
            }
        });
    </script>
}

<!-- Kritik Bilgi: Html.Raw ve Json.Serialize Bu sayfada en can alıcı nokta, C# tarafındaki 
listeyi JavaScript grafik kütüphanesine (Chart.js) nasıl aktardığındır. "C# nesnelerini JavaScript 
dizilerine dönüştürmek için  --- Html.Raw Json.Serialize(...))
 yöntemini kullandım. Bu sayede APIden gelen veriler, sayfa yüklenirken doğrudan grafik motoruna besleniyor.
  Bu, Server-Side Rendering (SSR) yani sunucu tarafında işleme ile dinamik görselleştirmenin en hızlı yoludur  -->