@model IEnumerable<ECommerce.Application.DTOs.Review.ReviewDto>

<div class="page-header d-flex justify-content-between mb-4">
    <h1 class="page-title">Yorum Moderasyonu</h1>
    <span class="badge bg-primary p-2">Toplam @Model.Count() Yorum</span>
</div>

<div class="card shadow-sm border-0" style="border-radius: 15px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Müşteri</th>
                        <th>Ürün</th>
                        <th>Yorum</th>
                        <th>Puan</th>
                        <th>Tarih</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        <tr>
                            <td class="ps-4"><strong>@review.CustomerName</strong></td>
                            <td><span class="text-muted">@review.ProductName</span></td>
                            <td><small>@review.Comment</small></td>
                            <td>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-light")"></i>
                                }
                            </td>
                            <td>@review.CreatedDate.ToString("dd.MM.yyyy")</td>
                            <td class="text-center">
                                <form asp-action="Delete" asp-route-id="@review.Id" method="post" onsubmit="return confirm('Bu yorumu silmek istediğinize emin misiniz?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 bg-light">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>