@model IEnumerable<ECommerce.Application.DTOs.Company.CompanyDto>
@{
    ViewData["Title"] = "Şirket Yönetimi";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title">Kayıtlı Şirketler</h1>
    </div>

<div class="card shadow-sm border-0" style="border-radius: 15px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Şirket Adı</th>
                        <th>Telefon</th>
                        <th>API Key</th>
                        <th class="text-center">Onay Durumu</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var company in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@company.Name</td>
                            <td>@company.Phone</td>
                            <td><small class="text-muted">@company.ApiKey</small></td>
                            <td class="text-center">
                                <span class="badge @(company.IsApproved ? "bg-success" : "bg-warning")">
                                    @(company.IsApproved ? "Onaylı" : "Beklemede")
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Update" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary border-0">
                                    <i class="fas fa-edit"></i> Düzenle
                                </a>
                                <form asp-action="Delete" asp-route-id="@company.Id" method="post" class="d-inline" onsubmit="return confirm('Şirketi silmek istediğinize emin misiniz?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>