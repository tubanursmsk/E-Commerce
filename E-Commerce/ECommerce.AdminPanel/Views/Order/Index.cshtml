@model IEnumerable<ECommerce.Application.DTOs.Order.OrderDto>

<div class="page-header d-flex justify-content-between mb-4">
    <h1 class="page-title">Sipariş Yönetimi</h1>
    <span class="badge bg-primary p-2">Toplam @Model.Count() Sipariş</span>
</div>

<div class="card shadow-sm border-0" style="border-radius: 15px;">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Sipariş No</th>
                    <th>Müşteri</th>
                    <th>Tarih</th>
                    <th>Tutar</th>
                    <th>Durum</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="ps-4"><code>#@order.OrderNumber</code></td>
                        <td>@order.CustomerFullName</td>
                        <td>@order.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="fw-bold">
                            @if (order.TotalAmount > 0)
                            {
                                @order.TotalAmount.ToString("N2")
                            }
                            else
                            {
                                @order.OrderItems.Sum(x => x.Price * x.Quantity).ToString("N2")
                            }
     ₺
                        </td>
                        <td>
                            @switch (order.Status)
                            {
                                case ECommerce.Domain.Enums.OrderStatus.Pending:
                                    <span class="badge bg-warning text-dark">Beklemede</span>
                                    break;
                                case ECommerce.Domain.Enums.OrderStatus.Completed:
                                    <span class="badge bg-success">Tamamlandı</span>
                                    break;
                                case ECommerce.Domain.Enums.OrderStatus.Cancelled:
                                    <span class="badge bg-danger">İptal Edildi</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@order.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-search"></i> Detay
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>