            //}
        });

        $("#closePop").click(function () {
            $("main").removeClass("overlay-bg active");
            $("main").removeClass("pRelative");
            $("main").css("pointer-events", "auto");
            $("body").css("background-color", "#fff");
            $(".extrawarrantyPopup").addClass("hide");
            $(".extrawarrantyPopup_BTN").removeClass("hide");
            $(".courier").removeClass("hide");
            localStorage.setItem("extrawarrantypop", "true");

        });

        $(".extrawarrantyPopup_BTN").click(function () {
            $("main").addClass("overlay-bg active");
            $("main").addClass("pRelative");
            $("main").css("pointer-events", "none");
            $("body").css("background-color", "#000");
            $(".overlay-bg").css("background-color", "#fff");
            $(".extrawarrantyPopup").removeClass("hide");
            $(".extrawarrantyPopup_BTN").addClass("hide");
            $(".courier").addClass("hide");
        });
    }

