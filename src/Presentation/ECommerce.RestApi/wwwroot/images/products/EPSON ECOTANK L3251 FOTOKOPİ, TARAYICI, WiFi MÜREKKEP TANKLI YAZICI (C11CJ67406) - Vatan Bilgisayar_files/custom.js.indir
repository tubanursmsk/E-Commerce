    //#region buyback campaign by productId
    $(document).ready(function () {
        var dataid = parseInt($(".product-id").attr("data-productid"), 10) || 0;
        var dataCat = $(".addProductToCompare").attr("data-category");
        var dataBr = $("#goinstore_key").attr("data-br");
        if ((dataCat == "CELCEP" || dataCat == "PC_POR" || dataCat == "PC_TAB") && dataid > 0) {
            $.ajax({
                url: "/Landing/GetBuybackCampaignByProductId/",
                data: JSON.stringify({ ProductId: dataid }),
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                type: "POST",
                success: function (data) {
                    if (data != null) {
                        buybackAmount = data?.Amount;
                        buybackAmounts = parseFloat(buybackAmount);
                        buybackAmounts.toFixed(2);
                        var buybackinfo = document.getElementById('degistokus');
                        var buybackicon = document.getElementById('buybackicon');
                        var buybacktext;
                        var url = "https://www.vatanbilgisayar.com/eskiyi-getir-yeniyi-gotur-telefon/";
                        if (dataCat == "CELCEP") {
                            /*     url = dataBr == "APPLE" ? "/degis-tokus" : "/eskiyi-getir-yeniyi-gotur-telefon";*/
                            buybacktext = dataBr == "APPLE" ? 'Degiş Tokuş kampanyası ile ' + buybackAmounts + '  TL ek indirim fırsatı' : 'Eskiyi Getir Yeniyi Götür ile ' + buybackAmounts + ' TL ek indirim fırsatı';
                            buybackinfo.innerHTML = buybacktext;
                            //buybackinfo.innerHTML = `<a target="_blank" href="` + url + `">` + buybacktext +` </a> &nbsp (` + buybackAmounts + ` TL ek ödeme)`;
                            //buybackicon.setAttribute('title', 'Geri alım kampanyası kapsamında bu ürünü satın alıp eski cihazınızı gönderdiğinizde, cihazınız için belirlenen geri alım bedeline ek ' + buybackAmounts + ' TL ödeme yapılacaktır.');
                            //buybackicon.setAttribute('data-original-title', 'Geri alım kampanyası kapsamında bu ürünü satın alıp eski cihazınızı gönderdiğinizde, cihazınız için belirlenen geri alım bedeline ek ' + buybackAmounts + ' TL ödeme yapılacaktır.');
                            //buybackicon.classList.remove("hide");
                        }
                        else if (dataCat == "PC_POR") {
                            url = url + "?type=macbook";
                            buybackinfo.innerHTML = `<a target="_blank" href="` + url + `">Geri alım kampanyası ile satın al </a> &nbsp (` + buybackAmounts + ` TL ek ödeme)`;
                            buybackicon.setAttribute('title', 'Geri alım kampanyası kapsamında bu ürünü satın alıp eski cihazınızı gönderdiğinizde, cihazınız için belirlenen geri alım bedeline ek ' + buybackAmounts + ' TL ödeme yapılacaktır.');
                            buybackicon.setAttribute('data-original-title', 'Geri alım kampanyası kapsamında bu ürünü satın alıp eski cihazınızı gönderdiğinizde, cihazınız için belirlenen geri alım bedeline ek ' + buybackAmounts + ' TL ödeme yapılacaktır.');
                            buybackicon.classList.remove("hide");
                        }
                        else if (dataCat == "PC_TAB") {
                            url = url + "?type=tablet";
                            buybackinfo.innerHTML = `<a target="_blank" href="` + url + `">Geri alım kampanyası ile satın al </a> &nbsp (` + buybackAmounts + ` TL ek ödeme)`;
                            buybackicon.setAttribute('title', 'Geri alım kampanyası kapsamında bu ürünü satın alıp eski cihazınızı gönderdiğinizde, cihazınız için belirlenen geri alım bedeline ek ' + buybackAmounts + ' TL ödeme yapılacaktır.');
                            buybackicon.setAttribute('data-original-title', 'Geri alım kampanyası kapsamında bu ürünü satın alıp eski cihazınızı gönderdiğinizde, cihazınız için belirlenen geri alım bedeline ek ' + buybackAmounts + ' TL ödeme yapılacaktır.');
                            buybackicon.classList.remove("hide");
                        }
                    }

                }
            });
        }

    });

    //#endregion
};


