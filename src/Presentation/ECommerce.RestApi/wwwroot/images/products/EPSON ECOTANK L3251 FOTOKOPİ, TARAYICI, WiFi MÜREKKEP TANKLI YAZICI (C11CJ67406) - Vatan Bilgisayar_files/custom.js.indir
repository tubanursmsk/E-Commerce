        );
        $('#totalRefund').html(
            '<p id="Pricetotal" style="background: #062665; width: 125px; text-indent: 5px; color: #fff; border-radius: 3px;"><b>' + buybackTotal + '</b> <b><span id="totaltl">TL</span></b></p>'
        );
    }

    $('#geriAlim').on('change', function () {
        returnPrice = $(this).val();
        var selectedText = $(this).find('option:selected').text();

        $('#card-text').html(
            '<b>' + returnPrice +
            '<span> TL</span></b>'
        );

        updateTotals();
    });

    $('#campaignProduct').on('change', function () {
        price = $(this).val();
        listPrice = $(this).find('option:selected').attr("data-value");
        phoneModel = $(this).find('option:selected').text();

        $('#alinan-telefon').html(
            'Satın Alacağınız Telefon: <b>' + phoneModel + '</b><br>' +
            'Ek Ödeme Tutarı: <b>' + price + 'TL</b>'
        );

        updateTotals();
    });


    $('#buybackSteps').on('click', function (e) {
        e.preventDefault();

        $('html, body').animate({
            scrollTop: $('.buyback-steps').offset().top
        }, 800);
    });

    $('#basvur').on('click', function (e) {
        e.preventDefault();

        $('html, body').animate({
            scrollTop: $('.buyback-info').offset().top
        }, 800);
    });


    // SELECT2
    $('#geriAlim').select2({
        placeholder: "Cihazınızı seçin",
        allowClear: true,
        templateResult: formatOption,
        templateSelection: formatOption
    });
    $('#campaignProduct').select2({
        placeholder: "Cihazınızı seçin",
        allowClear: true,
        templateResult: formatOption,
        templateSelection: formatOption

    });


    function formatOption(option) {
        if (!option.id) {
            return option.text;
        }

        var $option = $(
            '<span><i class="' + $(option.element).data('icon') + '"></i> ' + option.text + '</span>'
        );

        return $option;
    }


};

Engine.unsubscribeEmail = function () {

    $("#account-cancel-no").click(function () {
        var email = $("#account-cancel-no").attr("data-email");
        var token = getRequestToken();
        locked();
        $.ajax({
            url: "/DynamicLandings/UnsubscribeFromEmailPost/",
            data: {
                encryptedEmail: email,
                __RequestVerificationToken: token,
            },
            type: "POST",
            success: function (data) {
                if (data == "success") {
                    $(".cancel-question").addClass("hide");
                    $(".cancel-error").addClass("hide");
                    $(".cancel-success").removeClass("hide");
                    unlocked();
                }
                else {
                    $(".cancel-question").addClass("hide");
                    $(".cancel-error").removeClass("hide");
                    unlocked();
                }

            },
            error: function (ajaxContext) {
                unlocked();
            }
        });
    });
};

//#region Methods
function getParameterByName(name, url) {
    if (!url) url = window.location.href;
    name = name.replace(/[\[\]]/g, '\\$&');
    var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
        results = regex.exec(url);
    if (!results) return null;
    if (!results[2]) return '';
    return decodeURIComponent(results[2].replace(/\+/g, ' '));
}

function setUrlParam(key, value) {
    var queryParameters = {}, queryString = location.search.substring(1),
        re = /([^&=]+)=([^&]*)/g, m;
    while (m = re.exec(queryString)) {
        queryParameters[decodeURIComponent(m[1])] = decodeURIComponent(m[2]);
    }
    queryParameters[key] = value;
    bundleList = value;
    location.hash = "";
    //location.search = $.param(queryParameters);

    var productId = $(".product-id").attr("data-productId");
    locked();

    $.ajax({
        type: "GET",
        url: "/ProductDetail/DetailPagePartial",
        data: { "id": productId, "ubn": value },
        success: function (data) {
            $(".detailPartialPage").html(data);
            detailAjaxWorks()
            //history.pushState(productId, null, href)
            $(".wrapper-product-detail-").hide();
            $(".wrapper-product--visit").hide();
            detailUI.init();
            unlocked();
            cpSidebarContent();
            gauge();
        }
    });




}

