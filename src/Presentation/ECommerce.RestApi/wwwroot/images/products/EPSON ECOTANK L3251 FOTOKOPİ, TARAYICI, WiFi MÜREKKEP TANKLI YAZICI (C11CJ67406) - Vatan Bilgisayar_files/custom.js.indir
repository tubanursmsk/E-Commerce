            $("#TermsAndConditions").click(function () {
                if ($(this).prop("checked")) {
                    $.ajax({
                        url: '/MemberTransaction/SetTrueForAcceptCampaignMail/',
                        type: 'POST',
                        success: function (data) {
                            $.fancybox.close();
                            showMessage("Bu ürünün fiyatı düştüğünde size haber vereceğiz.");
                        }
                    });
                } else {

                }
            });
        }




        function favoriteAdd(e) {
            $.ajax({
                url: url,
                data: {
                    "productId": ids,
                    "type": type,
                    __RequestVerificationToken: token
                },
                type: "Post",
                success: function (data) {
                    unlocked();
                    if (data.statu) {
                        if (data.added) {
                            $(e).addClass("active").addClass("isFavorite")
                            $("#favoriteButtonIcon").removeClass("icon-heart").addClass("icon-heart-alt").css("color", "#003277");
                            $(".icon-heart-alt").css("color", "#003277");
                            getPopup.favorite(producttitle, message,
                                "Size haber verilmesini istediğiniz ürünleri favori listem sayfasından takip edebilirsiniz.",
                                "Favori Listem",
                                "/uyeBilgi/favorilistem/");
                        } else {
                            showMessage("Ürün, favori listenizden çıkarıldı.");
                            $(e).removeClass("active").removeClass("isFavorite")
                            $("#favoriteButtonIcon").removeClass("icon-heart-alt").addClass("icon-heart").css("color", "")
                            $(".icon-heart-alt").css("color", "");
                            $(".product-list__description").trigger("click");
                            CheckFavourites();
                        }
                    } else {
                        showMessage(data.message);
                    }
                }

            });
        }


    });

