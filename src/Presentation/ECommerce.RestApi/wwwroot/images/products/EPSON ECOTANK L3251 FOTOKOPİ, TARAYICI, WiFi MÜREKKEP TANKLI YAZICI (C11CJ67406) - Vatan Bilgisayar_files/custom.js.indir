    function extrawarrantyPopupBTN() {

        setTimeout(function () {
            var basketItems;

            for (var i = 0; i < dataLayer.length; i++) {
                if (dataLayer[i].BasketProducts) {
                    basketItems = dataLayer[i].BasketProducts;
                }
            }



            if (basketItems.length <= 1 && $("div").hasClass("basket-installment-carousel")) {

                if ($(".extrawarrantyPopup").hasClass("hide")) {
                    $(".extrawarrantyPopup_BTN").removeClass("hide");
                    $("body").css("background-color", "#fff");
                    $("main").addClass("pRelative");
                    $(".courier").addClass("hide");

                    var arrPrice = new Array();
                    $.each($('.basket-cart__extrawarranty-price'), function () {
                        arrPrice.push($(this).attr('add_prc'));
                    });

                    var discountPrice = new Array();
                    $.each($('.basket-cart__extrawarranty-price'), function () {
                        var addPrice = $(this).attr('add_prc');
                        var prcSfs = addPrice.toString().replace('.', '');
                        var prcFloa = parseFloat(prcSfs)
                        var prcStr = prcFloa.toString().replace('.', '');
                        var prcDisc = prcStr * 10 / 100;
                        var prcDiscFloor = Math.floor(prcDisc)
                        var prcDiscount = prcStr - prcDiscFloor;
                        const formatNum = n => Array.from(String(n)).reverse().map((a, i) => {
                            if ((i % 3 == 0) && (i > 0)) return a + "."; return a;
                        }).reverse().join("");
                        var prcFormat = formatNum(prcDiscount);
                        discountPrice.push(prcFormat);
                    });

                    for (var b = 0; b < arrPrice.length; b++) {
                        $(".oldPrice_add")[b].prepend(arrPrice[b]);

                    }
                    for (var c = 0; c < discountPrice.length; c++) {
                        $(".newPrice_add")[c].prepend(discountPrice[c]);
                    }


                }

            } else {

            }
        }, 1000)

        var arrAdd = new Array();
        $.each($('.wrapper-radio-product>input'), function () {
            arrAdd.push($(this));
        });


        function copyToClipboard(text) {
            var sampleTextarea = document.createElement("textarea");
            document.body.appendChild(sampleTextarea);
            sampleTextarea.value = text;
            sampleTextarea.select();
            document.execCommand("copy");
            document.body.removeChild(sampleTextarea);
        }

        $('.extrawarrantyPopup_add').click(function (e) {
            if ($(this).attr('id') == "addplus1") {
                var copyText = document.getElementById("extrawarranty_couponCode");
                copyToClipboard(copyText.value);
                $("#closePop").click();
            }

            //else if ($(this).attr('id') == "addplus2") {
            //    arradd[1].click();
            //}
            //else {
