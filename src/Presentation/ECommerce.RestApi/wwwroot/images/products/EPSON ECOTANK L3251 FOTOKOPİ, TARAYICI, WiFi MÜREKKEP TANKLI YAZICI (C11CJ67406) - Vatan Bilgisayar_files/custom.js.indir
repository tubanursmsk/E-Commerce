    }
}

function luhnCheck(cardNum) {
    var numericDashRegex = /^[\d\-\s]+$/;
    if (!numericDashRegex.test(cardNum)) return false;
    var nCheck = 0, nDigit = 0, bEven = false;
    var strippedField = cardNum.replace(/\D/g, "");
    for (var n = strippedField.length - 1; n >= 0; n--) {
        var cDigit = strippedField.charAt(n);
        nDigit = parseInt(cDigit, 10);
        if (bEven) {
            if ((nDigit *= 2) > 9) nDigit -= 9;
        }
        nCheck += nDigit;
        bEven = !bEven;
    }
    return (nCheck % 10) === 0;
}

function Valid() {
    var cardHolder = $("#cardholder").val();
    var cardNumber = $("#cardnumber").val();
    var cardmonth = $("#cardexpiredatemonth").val();
    var expiredDate = $("#cardexpiredateyear").val();
    var cvc = $("#cardcvv2").val();
    var installment = $('input[name=installment]:checked').val();
    var mpassCheck = $("#saveMyCard");
    var mpassCardName = $("#cardNameForMaster").val();


    if (!$('input[name=accountAliasName]:checked').length) {

        if (cardNumber.length != 16 || cardNumber == undefined || !luhnCheck(cardNumber)) {
            return "Geçersiz Kart Numarası";
        }
        if (cardHolder == '') {
            return "Geçersiz Kart Adı";
        }
        if (cardmonth == '') {
            return "Geçersiz Tarih";
        }
        if (expiredDate == '') {
            return "Geçersiz Tarih";
        }
        if (cvc == '') {
            return "Geçersiz Cvc No";
        }
    }
    if (installment == undefined) {
        return "Geçersiz Taksit Seçimi";
    }

    if (mpassCheck.prop('checked') === true && mpassCardName === "" && !$('input[name=accountAliasName]:checked').length) {
        return "Lütfen Masterpass Kart Adı Giriniz";
    }


}

function akbankDirekt(fromcredit) {
    debugger;
    if (fromcredit) {
        akbankDirektPay();
    }
    else {
        $.fancybox.open($('#akbankModal'));
        $("#akbankDirektOption").click(function () {
            debugger;
            akbankDirektPay();
        });
        $("#akbankIbanOption").click(function () {
            debugger;
            locked();
            var token = getRequestToken();
            $.ajax({
                url: "/Payment/PayWithTransfer/",
                type: "POST",
                data: {
                    "BankIBAN": $('input[name=transfer-type]:checked').val(),
                    __RequestVerificationToken: token
                },
                success: function (data) {
                    if (data.statu) {
                        location.href = data.redirect;
                    } else {
                        unlocked();
                        showMessage(data.message, "error", data.redirect);
                    }
                }
            });
        });
    }
    function akbankDirektPay() {
        locked();
        $.ajax({
            url: "/Payment/PayWithAkbankCreditAndTransfer/",
            type: "POST",
            success: function (data) {
                if (data !== undefined)
                    location.href = data;
                else
                    unlocked();
            },
            error: function (ajaxContext) {
                unlocked();
            }
        });
    }
}
