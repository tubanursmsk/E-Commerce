function fibaBankPay(fromcredit) {
    locked();
    $.ajax({
        url: $("#submitPayment").attr("data-comPayCreditPay"),
        type: "POST",
        data: { "fromcredit": fromcredit },
        success: function (data) {
            if (data.statu) {
                $("#paymentform").empty();
                $("#paymentform").append(data.form);
                $("#redirectForm").submit();
            } else {
                unlocked();
                showMessage(data.message, "error", data.redirect);
            }
        }
    });
}

function sendMasterPass() {
    var bankIca = $('input[name=payment-type-radio]:checked').val();
    $.ajax({
        url: "/payment/MasterPassCreditForm",
        type: "POST",
        data: { "bankIca": bankIca },
        success: function (data) {
            $("#masterpasscreditformappend").append(data);
            console.log($('#checkCredit-form'));
            MFS.getDigitalLoanUrl($('#checkCredit-form'), chkMPCreditResponseHandler);
            return false;
        }
    });
}


