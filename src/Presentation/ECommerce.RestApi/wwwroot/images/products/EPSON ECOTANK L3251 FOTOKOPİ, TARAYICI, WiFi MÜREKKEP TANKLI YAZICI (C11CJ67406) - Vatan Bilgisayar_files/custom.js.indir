$(document).ready(function () {
    var library = new Engine();
    Engine.init();

});


function Engine() {
    Engine.MasterPage();
}

Engine.init = function () {
    var module = this.getModul().split(',');
    for (var i = 0; i < module.length; i++) {
        this.runModule(module[i]);
    }
};

Engine.getModul = function () {
    var scripts = document.getElementById('engine');
    var queryString = scripts.getAttribute("data-module");
    return queryString;
};

Engine.runModule = function (module) {
    switch (module) {
        case "index":
            this.Index();
            break;
        case "productDetail":
            this.productDetail();
            break;
        case "categoryPage":
            this.categoryPage();
            break;
        case "comparePage":
            this.comparePage();
            break;
        case "orders":
            this.orders();
            break;
        case "delivery":
            this.delivery();
            break;
        case "memberMessage":
            this.memberMessage();
            break;
        case "memberAddress":
            this.memberAddress();
            break;
        case "memberInfo":
            this.memberInfo();
            break;
        case "pcBuild":
            this.pcBuild();
            break;
        case "payment":
            this.payment();
            break;
        case "contactForm":
            this.contactForm();
            break;
        case "buyBackPage":
            this.buyBackPage();
            break;
        case "degisTokus":
            this.degisTokusPage();
            break;
        case "unsubscribeEmail":
            this.unsubscribeEmail();
            break;
        case "basket":
            this.basket();
            break;
        case "login":
            this.login();
            break;
        default:
            break;
    }
};

Engine.MasterPage = function () {

    $("#redirectToMobile").click(async function () {
        const playStoreUrl = "https://play.google.com/store/apps/details?id=com.vatanbilgisayar.vatan&hl=tr";
        const appStoreUrl = "https://apps.apple.com/tr/app/vatan-bilgisayar/id438309785?l=tr";

        async function getDeviceType() {
            if (navigator.userAgentData) {
                const data = await navigator.userAgentData.getHighEntropyValues(["platform"]);
                const platform = data.platform.toLowerCase();

                const isAndroid = platform.includes("android");
                const isIOS = platform.includes("ios") || platform.includes("mac");

                return isAndroid ? "android" : isIOS ? "ios" : "unknown";
            } else {
                const userAgent = navigator.userAgent.toLowerCase();
                const isAndroid = /android/.test(userAgent);
                const isIOS = /iphone|ipad|ipod|Safari/i.test(userAgent);

                return isAndroid ? "android" : isIOS ? "ios" : "unknown";
            }
        }

        const deviceType = await getDeviceType();
        const storeUrl = deviceType === "android" ? playStoreUrl : deviceType === "ios" ? appStoreUrl : null;

        // if (!storeUrl) {
        // alert("Bu işletim sistemi desteklenmiyor.");
        // return;
        // }

        const timeout = setTimeout(() => {
            window.location.href = storeUrl;
        }, 2500);

        const currentUrl = window.location.href;
        const appUrl = currentUrl.replace(/^https?:/, "vatanmobil:");

        window.location.href = appUrl;
        // const iframe = document.createElement("iframe");
        // iframe.style.display = "none";
        // iframe.src = appUrl;
        // document.body.appendChild(iframe);

        window.addEventListener("visibilitychange", () => {
            clearTimeout(timeout);
        });
    });




    $('.ajax-form').on('submit', function (e) {
        e.preventDefault();

        const $form = $(this);
        const url = $form.attr('action');
        const method = $form.attr('method') || 'post';
        const data = $form.serialize();

        const onSuccess = $form.data('onsuccess');
        const onFailure = $form.data('onfailure');

        if (!$(this).valid()) {
            return
        }
        $.ajax({
            url: url,
            type: method,
            data: data,
            beforeSend: locked,
            success: function (response) {
                //if (onSuccess && typeof window[onSuccess] === 'function') {
                //    window[onSuccess](response);
                //}
                callHandler(onSuccess, response);

            },
            error: function (xhr) {
                //if (onFailure && typeof window[onFailure] === 'function') {
                //    window[onFailure](xhr);
                //}
                callHandler(onFailure, xhr);
            },
            complete: unlocked
            //complete: function () {
            //    unlocked()
            //}
        });
        function callHandler(handler, arg) {
            if (!handler) return;

            // 1) Doğrudan fonksiyon referansı
            if (typeof handler === 'function') {
                handler(arg);
                return;
            }

            if (typeof handler === 'string') {
                // "javascript:" önekini temizle
                const code = handler.replace(/^javascript:/i, '').trim();

                // Global fonksiyon adı mı?
                if (typeof window[code] === 'function') {
                    window[code](arg);
                } else {
                    // Hem 'response' hem 'data' parametre adıyla çağır
                    new Function('response', 'data', code)(arg, arg);
                }
            }
        }

    });

}


