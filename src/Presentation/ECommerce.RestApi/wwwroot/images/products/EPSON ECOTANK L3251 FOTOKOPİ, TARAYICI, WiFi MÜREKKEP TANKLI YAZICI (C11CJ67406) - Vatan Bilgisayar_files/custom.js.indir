    function updateVisibility() {
        const deviceCampaignDivHidden = $(".new_phoneSelect").hasClass("hide");
        const shouldShow = (deviceCampaignDivHidden && returnPrice) || (!deviceCampaignDivHidden && price && returnPrice);

        const elementsToToggle = ['#priceTotal', '#card-text', '#supportPrice', '#totalRefund'];

        elementsToToggle.forEach(selector => {
