Engine.pcBuild = function () {
    $(document).on('click', '.number-input .btn-plus', function () {
        var oldValue = parseFloat($(this).parent().find("input").val());
        var max = parseFloat($(this).parent().find("input").attr("max"));
        if (oldValue >= max) {
            newVal = oldValue;
            showMessage("Bu üründen daha fazla alamazsınız.");
        } else {
            var newVal = oldValue + 1;
        }
        $(this).parent().find("input").val(newVal);
    });
    $(document).on('click', '.number-input .btn-minus', function () {
        var oldValue = parseFloat($(this).parent().find("input").val());
        var newVal = oldValue - 1;
        if (newVal < 1) {
            newVal = 1;
            showMessage("Seçilen ürün adeti 1'den az olamaz.\nSeçilen ürün miktarı 1 olarak düzenlenmiştir.");
        }
        $(this).parent().find("input").val(newVal);
    });
    $(document).on('change', '.number-input input', function () {
        if ($(this).val() < 1) {
            $(this).val(1);
            showMessage("Seçilen ürün adeti 1'den az olamaz.\nSeçilen ürün miktarı 1 olarak düzenlenmiştir.")
        }
    });


    $(".add-to-cart").click(function () {

        var array = [];
        var proplist = [];
        var propertyErrorMessage = "";
        $(".summary-product-list tr").each(function () {
            var productId = $(this).attr("data-productid");
            var limitedStok = ($(this).attr("data-flag") == 1) ? true : false;
            var campaignId = $(this).attr("data-campaignid");
            var property = $(this).attr("data-property");
            proplist.push(property);
            var qty = $(this).data("count");
            if (!$.isNumeric(qty) || qty == 0) {
                qty = 1;
            }
            var obj = { ProductId: productId, LimitedStok: limitedStok, CampaignId: campaignId, Quantity: qty };
            array.push(obj);
        });
        if (!proplist.includes("OEMCPU"))
            propertyErrorMessage = propertyErrorMessage + "İşlemciler, ";
        if (!proplist.includes("OEMMBD"))
            propertyErrorMessage = propertyErrorMessage + "AnaKartlar, ";
        if (!proplist.includes("OEMMEM"))
            propertyErrorMessage = propertyErrorMessage + "Bellekler, ";
        if (!proplist.includes("OEMVGA"))
            propertyErrorMessage = propertyErrorMessage + "Ekran Kartları, ";
        if (!proplist.includes("OEMCAS"))
            propertyErrorMessage = propertyErrorMessage + "Kasalar ";

        if (propertyErrorMessage !== "") { showMessage("Lütfen " + propertyErrorMessage + " bölümlerindeki seçimlerinizi tamamlayınız.") }
        else {
            if ($(".summary-product-list tr").attr("data-property") === "OEMCPU" && $(".summary-product-list tr").attr("data-cpucool") === "0" && !$(".summary-product-list tr").is("[data-property=OEMCLL]")) {

                showConfirm("Sepetinize eklenecek olan işlemcide soğutucu mevcut değildir. Soğutucu eklemeden alışverişinizi tamamlamak istediğinize emin misiniz?",
                    function () {
                        addMultiProductsToBasket(array);
                    },
                    function () { }
                );
            }
            else {
                addMultiProductsToBasket(array);
            }
        }
    });
    function addMultiProductsToBasket(array) {
        locked();
        var token = getRequestToken();
        $.ajax({
            url: "/Basket/AddToBasket",
            data: {
                __RequestVerificationToken: token,
                basketMainItemViewModelList: array
            },
            dataType: "json",
            type: "post",
            success: function (data) {
                $("body").append(data.dataLayer);
                if (data.statu == "0" && data.message == "") {
                    data.message = "Ürünler Eklendi.";
                }
                showMessage(data.message);
                unlocked();
                RefreshBasketOpen();
            }
        });

    }
}


Engine.delivery = function () {
    $(".chooseAddress").on("checked", function () {
        var dataId = $(this).attr("data-address");
        $.ajax({
            url: this.data("url"),
            data: { addressId: dataId },
            dataType: "html",
            type: "GET",
            success: function (data) {
                $("#cargoList").html(data);
            }
        });
    });








}

Engine.orders = function () {

    function OnSuccess(response) {
        if (response.statu == "success") { showMessage(response.message, response.sorun == "0" ? "warning" : "error", location.href); }
        else {
            var message = document.getElementById("returnMessage");
            message.innerText = response.data;
        }
    }

    $(document).on("change", "#orderYearList", function () {
        location.href = window.location.href.split('?')[0] + "?year=" + $(this).val();
    });

    $(".orders").click(function () {
        if (!this.hasAttribute("filled")) {
            $(this).attr("filled", true);
            var el = $(this);
            var thid = $(this).data("thid");
            var mail = $(this).data("email");
            mail = mail == undefined ? "" : mail;
            var productReturnCode = $(this).data("returncode");
            var isReturn = $(this).data("isreturn");
            if (thid != "" && thid != undefined) {
                var token = getRequestToken();
                $.ajax({
                    url: $(this).data("url"),
                    data: {
                        th_id_list: thid,
                        email: mail,
                        returnCode: productReturnCode,
                        isReturn: (isReturn == "True" || isReturn == "true" ? true : false),
                        __RequestVerificationToken: token
                    },
                    dataType: "json",
                    type: "POST",
                    success: function (data) {
                        if (data.productMessage == null || data.productMessage == "") {
                            el.find(".product_list").html(data.productText);
                            el.find(".cargoPrice").html(data.cargoPriceText);
                            el.find(".product-list__price.totalPrice").html(data.totalPrice + "<span class='currencyText'>TL</span>");
                        }
                        else {
                            el.find(".product_list").html(data.productMessage);
                        }
                    }
                });
            }
        }
    });


    function downloadBill(url, filename) {
        fetch(url)
            .then(response => response.blob())
            .then(blob => {
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = filename;
                link.click();
            })
            .catch(console.error);
    }



    var urldownload;
    $(document).on("click", ".orderbill", function () {
        var thxref = $(this).data("thxref");
        if (thxref != "" && thxref != undefined && thxref != null) {
            var token = getRequestToken();
            $.ajax({
                url: $(this).data("url"),
                data: {
                    thxref: thxref,
                    __RequestVerificationToken: token
                },
                dataType: "json",
                type: "POST",
                success: function (data) {
                    $(".sendBillToMail").attr("data-thxref", thxref);
                    var binary_string = atob(data);
                    var len = data?.length;
                    var bytes = new Uint8Array(len);
                    for (var i = 0; i < len; i++) {
                        bytes[i] = binary_string.charCodeAt(i);
                    }
                    var blob = new Blob([bytes.buffer], { type: "application/pdf" });
                    var url = URL.createObjectURL(blob);
                    urldownload = url;

                    //var loadingTask = pdfjsLib.getDocument(url);
                    //loadingTask.promise.then(function (pdf) {

                    //    pdf.getPage(1).then(function (page) {
                    //        var scale = 1.0;
                    //        var viewport = page.getViewport({ scale: scale });

                    //        var canvas = document.getElementById('pdfCanvas');
                    //        var context = canvas.getContext('2d');
                    //        var deviceWidth = window.innerWidth;
                    //        scale = deviceWidth / viewport.width;
                    //        viewport = page.getViewport({ scale: scale });

                    //        canvas.height = viewport.height;
                    //        canvas.width = viewport.width;


                    //        var renderContext = {
                    //            canvasContext: context,
                    //            viewport: viewport
                    //        };
                    //        page.render(renderContext);
                    //    });
                    //});

                    $.fancybox.open($('#orderbillContent'));
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', error);
                }
            });
        }
    });




    $(".downloadbill").click(function () {
        downloadBill(urldownload, "FaturaBilgisi.pdf");
    });

    $(".sendBillToMail").click(function () {
        var thxref = $(this).data("thxref");
        if (thxref != "" && thxref != undefined && thxref != null) {
            var token = getRequestToken();
            $.ajax({
                type: "POST",
                url: '/MemberTransaction/GetToMail',
                cache: false,
                data: {
                    thxref: thxref,
                    __RequestVerificationToken: token
                },
                success: function (data) {
                    $.fancybox.open($('#orderbillemail__success'));
                    $(".sendBillToMail").addClass("disabled");
                    $(".sendBillToMail").attr("disabled", true);
                },
                error: function () {
                    $.fancybox.open($('#orderbillemail__failed'));
                }
            });
        }
    });


    $(document).on("click", "#btn_cancel_order", function () {
        var thid = $(this).attr("data-thid");
        $(".btn-cancelOrder").removeAttr("data-thid");
        $(".btn-cancelOrder").attr("data-thid", thid);
        $("#cancelModal #cancelModalLabel").text("SPR" + thid.toString() + " Nolu siparişin iptali");
        $("#cancelModal").modal("show");
    });

    //Return Order Button

    $(document).on("click", "#btn_return", function () {
        var thid = $(this).attr("data-thid");
        $(".btn-returnOrder").removeAttr("data-thid");
        $(".btn-returnOrder").attr("data-thid", thid);
        $("#returnModal #returnModalLabel").text("SPR" + thid.toString() + " Nolu siparişin iadesi");
        $("#returnModal").modal("show");
        $(".btn-returnOrder").prop('disabled', true);
    });


    $(document).on("click", ".btn-returnOrder", function () {
        $("#returnModal").modal("hide");
        $("#btn_return").addClass("hide");
        $("#returnOrder_message").removeClass("hide");
    });

    //Return Order Select

    $(document).ready(function () {
        var $selectElement = $(".returnSelect");
        var $infoDiv = $(".returninfo");
        var $otherReasonInput = $("#returnOtherReasonText");
        $infoDiv.addClass("hide");
        $selectElement.on("change", function () {
            if ($selectElement.val() === "Other") {
                $otherReasonInput.removeClass("hide");
                $infoDiv.addClass("hide");
            }
            else if ($selectElement.val() === "") {
                $infoDiv.addClass("hide");
                $(".btn-returnOrder").prop('disabled', true);
            }
            else {
                $otherReasonInput.addClass("hide");
                $infoDiv.removeClass("hide");
                $(".btn-returnOrder").prop('disabled', false);
            }

        });

        $otherReasonInput.on("input", function () {
            $infoDiv.removeClass("hide");
        });
    });


    let msg = `
        Teslim almadığınız siparişlerde Kolay İade işlemi yapılamaz. 
        Bu durumda iptal veya iade talebiniz için aşağıdaki kanallardan bizimle iletişime geçebilirsiniz.<br>
        📞 <a href="tel:08502225656" style="color:#007bff;text-decoration:underline;">Çağrı Merkezi: 0850 222 56 56</a><br>
        💬 <a href="https://wa.me/908502225656" target="_blank" style="color:#007bff;text-decoration:underline;">WhatsApp: 0850 222 56 56</a><br>
        ✉️ <a href="mailto:info@vatanbilgisayar.com" style="color:#007bff;text-decoration:underline;">info@vatanbilgisayar.com</a>
        `;


    //ürünü teslim almadım seçili ise ikondan modal acma
    $(document).on("click", "#notReceivedInfo", function (e) {
        e.preventDefault();
        showMessage(msg, "error");
    });





    //Yanlıs urun/Kusurlu urun 
    let currentProductId = null;

    $(document).on("change", ".returnReasonSelect", function () {
        let selectedText = $(this).find("option:selected").text();
        let productId = $(this).data("productid");
        let title = $(this).closest(".returnModal_products_box").find(".returnModal_products_box--title label").text().trim();
        let $cameraIcon = $(this).siblings(".camera-icon");

        if ($(this).val() == "4" || $(this).val() == "5" ||
            selectedText === "Yanlış Ürün Geldi" || selectedText === "Kusurlu Ürün Geldi") {

            $("#uploadProductTitle").text(title);
            $("#returnPhoto").val("");
            $("#uploadedImagesPreview").empty();
            //    $("#uploadImageModal").modal("show");                                                                            //fotograf ekleme modalı ıcın burayı acmak gerekıyor
            $(`.returnReasonSelect[data-productid='${productId}']`).siblings(".camera-icon").removeClass("hide");
            //   $(this).closest(".returnReason").addClass('flex-center');                                                   //fotograf ekleme modalı ıcın burayı acmak gerekıyor
            // $cameraIcon.removeClass("hide");                                                                             //fotograf ekleme modalı ıcın burayı acmak gerekıyor

        } else {
            $(this).siblings(".camera-icon").addClass("hide");
            //   $(this).closest(".returnReason").removeClass('flex-center');                                                   //fotograf ekleme modalı ıcın burayı acmak gerekıyor
            //$cameraIcon.addClass("hide");                                                                                  // fotograf ekleme modalı ıcın burayı acmak gerekıyor
        }
    });


    // kamera ikonuna basınca modal acma
    $(document).on("click", ".camera-icon", function () {
        let productId = $(this).siblings(".returnReasonSelect").data("productid");
        let title = $(this).siblings(".returnReasonSelect").data("title");

        currentProductId = productId;
        $("#uploadProductTitle").text(title);
        $("#returnPhoto").val("");
        $("#uploadedImagesPreview").empty();
        //    $("#uploadImageModal").modal("show");                                                                                 // fotograf ekleme modalı ıcın burayı acmak gerekıyor
    });

    // fotoğraf eklendiğinde
    $(document).on("change", "#returnPhoto", function (e) {
        let files = e.target.files;
        let maxFiles = 5;
        let maxSize = 5 * 1024 * 1024;
        let previewContainer = $("#uploadedImagesPreview");

        let currentCount = previewContainer.children().length;

        if (currentCount + files.length > maxFiles) {
            alert(`En fazla ${maxFiles} fotoğraf yükleyebilirsiniz. Şu anda ${currentCount} fotoğraf var.`);
            $(this).val("");
            return;
        }

        Array.from(files).forEach(file => {
            if (previewContainer.find(`[data-name='${file.name}']`).length > 0) {
                alert(`${file.name} zaten eklenmiş, tekrar yüklenemez.`);
                return;
            }

            if (file.size > maxSize) {
                alert(`${file.name} boyutu 5MB’dan büyük. Bu dosya yüklenmeyecek.`);
            } else {
                let reader = new FileReader();
                reader.onload = function (e) {
                    let imgHtml = `
                  <div style="position:relative; width:80px; height:80px;" data-name="${file.name}">
                      <img src="${e.target.result}" style="width:100%; height:100%; object-fit:cover; border:1px solid #ddd; border-radius:5px;">
                      <span class="remove-img" 
                            style="position:absolute; top:-5px; right:-5px; background:#f00; color:#fff; border-radius:50%; width:20px; height:20px; line-height:20px; text-align:center; cursor:pointer;">×</span>
                  </div>`;
                    previewContainer.append(imgHtml);
                }
                reader.readAsDataURL(file);
            }
        });

        $(this).val("");
    });

    $(document).on("click", ".remove-img", function () {
        $(this).parent().remove();
    });


    // Fotoğraf silme
    $(document).on("click", ".remove-img", function () {
        $(this).parent().remove();
    });



    // fotoğraf silme
    $(document).on("click", ".remove-img", function () {
        $(this).parent().remove();
        if ($("#uploadedImagesPreview").children().length === 0) {
            let reasonBox = $(`.returnReasonSelect[data-productid='${currentProductId}']`).parent();
            reasonBox.find(".photo-badge").addClass("hide").text("");
        }
    });

    // fotoğraf modalı kapandığında scrollu geri getir
    $('#uploadImageModal').on('hidden.bs.modal', function () {
        if ($('.modal.in').length) {
            $('body').addClass('modal-open');
        } else {
            $('body').removeClass('modal-open').css('padding-right', '');
        }
    });

    // Fotoğraf modalı açıldığında returnModal geri plana düşsün
    $('#uploadImageModal').on('show.bs.modal', function () {
        $("#returnModal").css('z-index', 'unset');
    });

    // Fotoğraf modalı kapandığında eski haline dönsün
    $('#uploadImageModal').on('hidden.bs.modal', function () {
        $("#returnModal").css('z-index', '1050');
    });


    //Dropdown alanı işlemleri
    $(document).on("change", "#canselReason", function () {

        let selectedText = $(this).children("option").filter(":selected").text();

        //if ($(this).val() == "4" ||
        //    $(this).val() == "5" ||
        //    selectedText === "Yanlış Ürün Geldi" ||
        //    selectedText === "Kusurlu Ürün Geldi") {
        //    $("#uploadImageModal").modal("show");
        //}

        if ($(this).val() == "Other" || selectedText == "Diğer" || selectedText == "Other" || selectedText == "Kusurlu Ürün Geldi" || $(this).val() == "5") {
            $(this).siblings("#cancelOtherReasonText").removeClass("hide"); 
            $(this)
                .closest(".returnModal_products_box")   // ürün kartı (örnek class)
                .find(".product-rebate-message")
                .removeClass("hide");

        }
        else {
            $(this).siblings("#cancelOtherReasonText")   .addClass("hide");
            $(this)
                .closest(".returnModal_products_box")   // ürün kartı (örnek class)
                .find(".product-rebate-message")
                .addClass("hide");
        }

        //ürünü teslim almadım secili ise butonu css tarafında sisable etme ve modal gosterme
        if ($(this).val() == "7" || selectedText == "Ürünü Teslim Almadım") {
            $("#notReceivedInfo").removeClass("hide");
            showMessage(msg, "error");
            $(".startReturnBtn").addClass("disabled");
        } else {
            $("#notReceivedInfo").addClass("hide");
            $(".startReturnBtn").removeClass("disabled");
        }

    });



    //Ürünü teslim almadım secılı ıse iade yapılamaması icin buton dısable edıldı
    $(document).on("change", ".returnModal .returnReason select, #canselReason", function () {

        var anyNotReceived = $(".returnModal .returnReason select, #canselReason").toArray().some(function (el) {
            var $el = $(el);
            var val = $el.val();
            var txt = $el.children("option").filter(":selected").text().trim();
            return val === "7" || txt === "Ürünü Teslim Almadım";
        });

        if (anyNotReceived) {
            $("#notReceivedInfo").removeClass("hide");
            $(".startReturnBtn").addClass("disabled").attr("aria-disabled", "true");
        } else {
            $("#notReceivedInfo").addClass("hide");
            $(".startReturnBtn").removeClass("disabled").removeAttr("aria-disabled");
        }
    });

    //eger dısabled ıse tıklamayı engelle
    $(document).on("click", ".startReturnBtn.disabled", function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        return false;
    });

    function toggleReturnButtonByOtherReason(el) {
        var $box = el.closest(".returnModal_products_box");
        var $otherText = $box.find("#cancelOtherReasonText");
        var $btn = $(".startReturnBtn");

        // textbox görünüyorsa kontrol et
        if ($otherText.length && $otherText.is(":visible")) {
            var text = $otherText.val().trim();
            var wordCount = text ? text.split(/\s+/).filter(Boolean).length : 0;

            if (wordCount < 3) {
                $btn.addClass("disabled").attr("aria-disabled", "true");
                return;
            }
        }

        $btn.removeClass("disabled").removeAttr("aria-disabled");
    }

    $(document).on("input", "#cancelOtherReasonText", function () {
        toggleReturnButtonByOtherReason($(this));
    });

    $(document).on("change", "#canselReason", function () {
        toggleReturnButtonByOtherReason($(this));
    });

    $(document).on("click", ".startReturnBtn.disabled", function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        return false;
    });






    $(".btn-cancelOrder").click(function () {
        var thID = $(this).data("thid");
        var uri = $(this).data("url");
        var cancelSelected = $("#canselReason option:selected");
        var orderreason = cancelSelected.text();
        if ($("#canselReason").val() == undefined || $("#canselReason").val() == "") {
            showMessage("Lütfen iptal sebebinizi seçiniz.", "warning");
        }
        else if ($("#canselReason").val() == "Other") {
            if ($("#cancelOtherReasonText").val() == "" || $("#cancelOtherReasonText").val() == undefined)//textbox sorgula
            {
                showMessage("Lütfen iptal sebebinizi yazınız.", "warning");
            }
            else {
                orderreason = $("#cancelOtherReasonText").val();
            }
        }
        showConfirm("İsteğiniz üzerine iptal kaydı alınacaktır. Devam etmek istiyor musunuz?",
            function () {
                if (!IsNullOrUndefined(thID)) {
                    var token = getRequestToken();
                    $.ajax({
                        url: uri,
                        data: {
                            th_id: thID,
                            note: orderreason,
                            __RequestVerificationToken: token
                        },
                        dataType: "json",
                        type: "POST",
                        success: function (data) {
                            $("#cancelModal").modal("hide");
                            if (data == null || data == "") {
                                if ($(".cancel_div") != undefined) {
                                    $(".cancel_div").text("İptal kaydınız alınmıştır.Ortalama 2-3 gün içerisinde ücret iadeniz yapılacaktır.");
                                }
                                showMessage("İptal kaydınız alınmıştır.Ortalama 2-3 gün içerisinde ücret iadeniz yapılacaktır.", "success");

                            }
                            else {
                                showMessage(data, "error");
                            }

                        }
                    });
                }

            },
            function () {
                return false;
            }
        )
    });

    $(document).on("click", ".productReturnBtn", function () {
        var returnProducts_div = $(this).closest(".order-product").find(".returnProducts");
        var productsModel = returnProducts_div.attr("data-returnProducts");
        var trnRef = returnProducts_div.attr("data-TrnRef");
        var orderId = $(this).attr("data-orderId");

        //var token = getRequestToken();

        $.ajax({
            type: "POST",
            url: "/DynamicLandings/_ProductReturn/",
            data: {
                products: productsModel,
                trnRef: trnRef,
                //__RequestVerificationToken: token,
            },
            success: function (data) {

                $(".returnModal").html(data);
                $(".returnModal #returnModalSipNo span").html(orderId);
                $(".startReturnBtn").attr("data-TrnRef", trnRef);
            }
        })

    });
    $(document).on("click", ".startReturnBtn", function () {
        var token = getRequestToken();
        var returnedProductList = [];
        var error = false;
        var TrnRef = $(this).attr("data-TrnRef");
        var email = "";

        if ($("#Item1_Email").length > 0) {
            email = $("#Item1_Email").val();
        }
        var $container = $(this).closest(".returnModal_products");
        var selectedProductList = $container.find('input.returnCheck:checked');                             //bu kısım duzenlendi
        selectedProductList.each(function (index, item) {
            var count = $(item).parent().parent().find("select.productQty").val();
            var cancelSelected = $(item).parent().parent().find("#canselReason option:selected");
            var orderreasonText = "";
            var orderreasonId = cancelSelected.val();
            if (orderreasonId == "" || orderreasonId == undefined) {
                showMessage("Lütfen iade sebebinizi seçiniz.", "warning");
                error = true;
            }
            else {
                orderreasonText = $(item).parent().parent().find("#cancelOtherReasonText").val();
                var product_code = $(item).parent().find(".returnModal_products_box--title .code").text();
                var product_title = $(item).parent().find(".returnModal_products_box--title label").text();
                var product_price = $(item).parent().find(".returnModal_products_box--title #returModalPrice").text();
                var product_image = $(item).parent().find(" .returnModal_products_box--image img").attr("src");

                var obj = { productLineId: item.value, count: count, I_ID: orderreasonId, I_Title: orderreasonText, code: product_code, title: product_title, price: product_price, image: product_image };
                returnedProductList.push(obj);
            }

        });
        if (error == false) {
            if (returnedProductList == "" || returnedProductList.count < selectedProductList.count) {
                showMessage("Lütfen iade etmek istediğiniz ürünü seçiniz.", "warning");
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/DynamicLandings/SetReturnProductsInfo/",
                    data: {
                        requestReturnProductsModel: {
                            email: email,
                            trnRef: TrnRef,
                            productIdListWithReason: returnedProductList
                        },
                        __RequestVerificationToken: token,
                    },
                    success: function (data) {
                        if (data.Success) {
                            $("#returnCodeModal").html(data.partial);
                            $('#returnModal').modal('hide');
                            $('#returnCodeModal').modal('show');

                        }
                        else {
                            showMessage(data.Message, "error");
                        }

                    }
                });
            }
        }


    });
    $('#returnCodeModal').on('hidden.bs.modal', function () {
        location.href = location.href;
    });
    $(document).on("click", ".cancelIadeBtn", function () {
        var email = "";
        if ($("#Item1_Email").length > 0) {
            email = $("#Item1_Email").val();
        }
        var trnRef = $(this).attr("data-trnRef");
        var returnedCode = $(this).attr("data-returnedCode");
        var returnCargoType = $(this).attr("data-return_cargotype");
        var returnCargoId = $(this).attr("data-return_cargoid");
        var token = getRequestToken();
        $.ajax({
            type: "POST",
            url: "/DynamicLandings/CancelReturnProducts/",
            data: {
                email: email,
                trnRef: trnRef,
                cargoKey: returnedCode,
                cargoType: returnCargoType,
                cargoId: returnCargoId,
                __RequestVerificationToken: token,
            },
            success: function (data) {
                if (data.Success) {
                    showMessage("İşlem başarılı.", "info", location.href);
                }
                else {
                    showMessage(data.Message, "error");
                }

            }
        });
    });
}

Engine.comparePage = function () {

