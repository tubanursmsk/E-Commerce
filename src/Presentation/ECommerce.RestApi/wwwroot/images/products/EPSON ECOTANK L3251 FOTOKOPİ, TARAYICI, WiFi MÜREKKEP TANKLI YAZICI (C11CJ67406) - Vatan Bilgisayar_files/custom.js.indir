function chkMPCreditResponseHandler(status, response) {
    console.log(response);
    if (response.responseCode == "5009") {
        var loandigital = $("#LoanDigital").val();
        var mspassOrderno = $("#MpassOrderNo").val();
        var resultCreditUrl = $("#creditResultUrl").val();
        var urlSource = response.urlLoan + '&iframeSignature=' + loandigital + '&returnUrl=' + resultCreditUrl;
        console.log(urlSource);
        document.getElementById('masterPassLoanFrame').src = urlSource;
        $.fancybox.open({
            src: "#masterpasscreditModal",
            type: "inline",
            clickSlide: 'false',
            clickOutside: 'false',
            showCloseButton: 'false',
            "touch": false,
            smallBtn: false,
            toolbar: false,
            modal: true
        });



    } else {
        console.log(response.responseDescription);
    }
    unlocked();
}

function post(path, params, method = 'post') {
    const form = document.createElement('form');
    form.method = method;
    form.action = path;
    for (const key in params) {
        if (params.hasOwnProperty(key)) {
            const hiddenField = document.createElement('input');
            hiddenField.type = 'hidden';
            hiddenField.name = key;
            hiddenField.value = params[key];

            form.appendChild(hiddenField);
        }
    }
    document.body.appendChild(form);
    form.submit();
}

