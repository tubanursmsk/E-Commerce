function gauge() {
    var gua = $("#scoreGauage");





    if (gua.length) {

        var mingua = Number(gua.attr("data-min"));
        var maxgua = Number(gua.attr("data-max"));
        var centergua = Math.floor((mingua + maxgua) / 2);


        var scoreGua = gua.attr("data-score");
        var opts = {
            angle: 0.20, // The span of the gauge arc
            lineWidth: 0.09, // The line thickness
            radiusScale: .4, // Relative radius
            pointer: {
                length: 0.30, // // Relative to gauge radius
                strokeWidth: 0.018, // The thickness
                color: '#003177' // Fill color
            },

            staticLabels: {
                font: "10px Roboto, Arial, sans-serif", // Specifies font
                labels: [minpcgua, centerpcgua, maxpcgua], // Print labels at these values
                color: "#333", // Optional: Label text color
                fractionDigits: 0 // Optional: Numerical precision. 0=round off.
            },

            renderTicks: {
                divWidth: 3,
            },


            limitMax: true, // If false, max value increases automatically if value > maxValue
            limitMin: true, // If true, the min value of the gauge will be fixed
            colorStart: '#6FADCF', // Colors
            colorStop: '#1bc078', // just experiment with them
            strokeColor: '#E0E0E0', // to see which ones work best for you
            generateGradient: true,
            highDpiSupport: true, // High resolution support

        };
        var target = document.getElementById('scoreGauage'); // your canvas element
        var gauge = new Gauge(target).setOptions(opts); // create sexy gauge!
        gauge.maxValue = maxgua; // set max gauge value
        gauge.setMinValue(mingua);  // Prefer setter over gauge.minValue = 0
        gauge.animationSpeed = 10; // set animation speed (32 is default value)
        gauge.set(scoreGua); // set actual value
    }

    var pcmark = $("#pcmark-scoreGauage");
    if (pcmark.length) {

