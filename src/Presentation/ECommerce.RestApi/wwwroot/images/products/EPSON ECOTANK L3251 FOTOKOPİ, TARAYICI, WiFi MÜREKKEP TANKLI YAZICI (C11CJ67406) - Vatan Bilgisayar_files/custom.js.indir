                    results.removeClass('active');
                }
            },
                100);

        });


    $(document).ready(function () {
        $('.spec-label[aria-expanded="true"]').click();
    });


};

Engine.categoryPage = function () {

    // Sayfa bfcache'den geri geldiyse loader'ı kapatma
    window.addEventListener("pageshow", function (e) {
        if (e.persisted) {
            unlocked();
            scrollToFocusedProduct();
        }

        // DOM gecikince
        let tries = 0;
        const maxTries = 20;

        const timer = setInterval(() => {
            tries++;

            if (scrollToFocusedProduct()) {
                clearInterval(timer);
            }

            if (tries >= maxTries) {
                clearInterval(timer);
            }
        }, 50);
    });

    document.addEventListener('mousedown', function (event) {
        if (!event.target.closest('a.product-list-link')) return;

        StoreProductId(event);
    });


    function StoreProductId(event) {
        const link = event.target.closest('a.product-list-link');
        if (!link) return;

        const productWrapper = link.closest('.product-list');
        if (!productWrapper) return;

        const codeEl = productWrapper.querySelector('.product-list__product-code');
        if (!codeEl) return;

        const productId = codeEl.textContent.trim();
        if (!productId) return;

        sessionStorage.setItem('focusProductId', productId);

      //  console.log('focusProductId stored:', productId);
    }


    function scrollToFocusedProduct() {
        const productId = sessionStorage.getItem('focusProductId');
        if (!productId) return false;

        const codeEls = document.querySelectorAll('.product-list__product-code');

        for (const codeEl of codeEls) {
            if (codeEl.textContent.trim() === productId) {
                const productWrapper = codeEl.closest('.product-list');
                if (!productWrapper) return false;

                const link = productWrapper.querySelector('a.product-list-link');
                if (!link) return false;

                link.scrollIntoView({
                    block: 'center',
                    behavior: 'auto'
                });

              //  console.log('Scrolled to product:', productId);
                return true;
            }
        }

        return false;
    }


    var categoryCode = $("#visilabs-categoryId").val();
    var param = getParameterByName("srt");
    $("#sortOptionsDesktop > option").each(function () {
        if (this.value == param) {
            this.selected = 'selected';
        }
    });

    $('#searchwithword').keypress(function (e) {
        if (e.which == 13) {
            $('.searchwithword').click();
        }
    });


    

    $("#FilterBrandSearch").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $(".filter-list__item[data-count='1']").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    });

    
    let loadNextPage;
    let loadPrevPage;

    (function initLoadMore() {
        const container = document.getElementById('productContainer');
        const btnNext = document.getElementById('loadMoreBtn');
        const btnPrev = document.getElementById('loadPrevBtn');
        const sentinel = document.getElementById('loadMoreSentinel');

        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }


        // Eğer gerekli elementler yoksa çık
        if (!container || !btnNext || !sentinel) return;

        /* ------- ORTAK STATE ------- */
        let loadingNext = false;
        const urlPage = parseInt(new URLSearchParams(location.search).get('page') || '1', 10);
        btnNext.dataset.currentPage = urlPage;
        let minLoadedPage = Math.max(urlPage, +btnNext.dataset.currentPage);  // ör. 6

        togglePrevBtn = async function () {
            if (!btnPrev) return;
            if (minLoadedPage > 1) {
                btnPrev.classList.remove('hidden');
                btnPrev.style.display = 'flex';
                btnPrev.dataset.prevPage = minLoadedPage - 1;   // 6→5, 5→4, …
            } else {
                btnPrev.style.display = 'none';
                btnPrev.classList.add('hidden');
            }
        }

        container.addEventListener('click', event => {
            const link = event.target.closest('.product-list-link');
            if (!link) return;

            const page = Number(link.dataset.page);
            if (!Number.isFinite(page)) return;

            updatePageInUrl(page); // Tüm özel serileştirme & ? kaldırma burada
            scrollToFocusedProduct();

        });


      


        loadPrevPage = async function () {
            if (!btnPrev) return;
            const prev = +btnPrev.dataset.prevPage;         // 6→5→4 …
            if (prev < 1) return;

            btnPrev.classList.add('is-loading');
            try {
                const r = await fetch(buildFetchUrl(prev), { credentials: 'same-origin' });
                if (!r.ok) throw new Error(r.statusText);

                container.insertAdjacentHTML('afterbegin', await r.text()); // üste ekle

                lazyLoadImages(container);

                lowestPriceControl();

                minLoadedPage = prev;
                await togglePrevBtn();
                updatePageInUrl(prev);

            } catch (e) { console.error('LoadMore error', e); }
            finally {
                btnPrev.classList.remove('is-loading');
            }
        };
        btnPrev?.addEventListener('click', loadPrevPage);


        loadNextPage = async function () {
            const next = +btnNext.dataset.currentPage + 1;
            const total = +btnNext.dataset.totalPages;
            // Eğer yükleme işlemi devam ediyorsa veya son sayfaya ulaşıldıysa çık
            if (loadingNext || next > total) return;

            loadingNext = true;
            btnNext.classList.add('is-loading');

            try {
                const resp = await fetch(buildFetchUrl(next), { credentials: 'same-origin' });
                if (!resp.ok) throw new Error(resp.statusText);

                //Seçilen elemanın sonuna HTML olarak yeni ürünleri ekle
                container.insertAdjacentHTML('beforeend', await resp.text());

                //Görseller yüklendiğinde lazy loading işlemi yap
                lazyLoadImages(container);


                //Ürün kartlarında indirim kontrolü
                lowestPriceControl();

                btnNext.dataset.currentPage = next;

                //URL'yi güncelle
                updatePageInUrl(next);

                // Eğer son sayfaya ulaşıldıysa butonu kaldır
                if (next >= total) btnNext.remove();

            } catch (err) {
                console.error('LoadMore error', err);
            } finally {
                loadingNext = false;
                btnNext.classList.remove('is-loading');
                container.dispatchEvent(new Event('loadMoreDone'));
            }
        };

        function updatePageInUrl(page) {
            const url = new URL(location.href);
            const params = url.searchParams;

            // opf varsa sondaki /'ları temizle
            if (params.has('opf')) {
                params.set('opf', params.get('opf').replace(/\/+$/, ''));
            }

            // page doğrulama
            const p = Number(page);
            if (Number.isFinite(p) && p > 1) {
                params.set('page', String(Math.floor(p)));
            } else {
                params.delete('page');
            }

            // Özel serileştirme: opf'te , kodlanmasın; diğerleri normal encode
            const parts = [];
            for (const [k, v] of params.entries()) {
                const key = encodeURIComponent(k);
                let val = encodeURIComponent(v);
                if (k === 'opf') {
                    // sadece virgülü aç, diğer kodlamalara dokunma
                    val = val.replace(/%2C/gi, ',');
                }
                parts.push(`${key}=${val}`);
            }


            url.search = parts.length ? `?${parts.join('&')}` : '';
            history.replaceState({ productPage: page }, '', url.toString());

        }

        function buildFetchUrl(page) {
            const params = new URLSearchParams(location.search);
            params.set('page', page);
            params.set('href', removePageParam(location.href));
            return `/Category/LoadMoreProducts?${params.toString()}`;
        }
        function removePageParam(url) {
            // URL mutlak değilse base ver (gerekirse):
            const u = url.startsWith('http') ? new URL(url) : new URL(url, 'http://localhost');
            u.searchParams.delete('page');         // "page" paramını çıkar
            return u.toString();                   // Gerekirse '?' otomatik kaldırılır
        }

        function lazyLoadImages(container) {
            if (window.lazySizes) {
                lazySizes.loader.unveilDom(container);
            } else if (window.lazyLoadInstance) {
                window.lazyLoadInstance.update();
            } else {
                container.querySelectorAll('img.lazyimg[data-src]')
                    .forEach(img => {
                        img.src = img.dataset.src;
                        img.classList.remove('lazyimg');
                    });

                //badge'ler için güncelleme
                container.querySelectorAll('.prd-badge img[data-src]')
                    .forEach(img => {
                        if (!img.src || img.src.trim() === '') {
                            img.src = img.dataset.src;
                        }
                        img.removeAttribute('data-src');
                    });

            }
        }

        btnNext.addEventListener('click', loadNextPage);

        //İzlenen div ekrana 400px yaklaştığında loadNextPage (Yeni ürünleri getir) fonksiyonunu çağır
        new IntersectionObserver(
            entries => { if (entries[0].isIntersecting) loadNextPage(); },
            { rootMargin: '200px' }
        ).observe(sentinel);
    })();

    togglePrevBtn();
}

Engine.memberMessage = function () {
    $("#SelectedMainTypeId").change(function () {
        locked();
        $.ajax({
            url: $("#messageType").attr("data-url"),
            data: {
                Id: $(this).val()
            },
            success: function (data) {
                unlocked();
                $('#SelectedSubTypeId').empty();
                $.each(data, function (index, data) {
                    $('#SelectedSubTypeId').append($('<option/>', {
                        value: data.ID,
                        text: data.Name
                    }));
                });
            }
        });
    });

    $("#SelectOrderId").change(function () {
        var thid = $('option:selected', this).attr('data-thid');
        if (!thid) {
            $('#selectedOrderIdList').empty();
        }
        else {
            locked();
            $.ajax({
                url: $("#orders").attr("data-url"),
                data: {
                    TH_ID: thid
                },
                success: function (data) {
                    unlocked();
                    $('#selectedOrderIdList').empty();
                    $.each(data, function (index, data) {
                        console.log(data);
                        $('#selectedOrderIdList').append($('<option/>', {
                            value: data.I_ID,
                            text: data.I_Title
                        }));
                    });
                }
            });
        }

    });
    $("#sendNewMessage").click(function () {
        $("#messageSendForm").removeClass("hide");
    });
}


Engine.memberAddress = function () {
    $(document).ready(function () {
        if (window.location.search.indexOf('?adr=') !== -1) {
            $('.addressForm').removeClass('hide');
            $('.callNewAddressForm').addClass('hide');

        }
        $('.callNewAddressForm').on('click', function () {
            $('.addressForm').removeClass('hide');
        });
    });
}

Engine.memberInfo = function () {
    $(document).on("click", ".cancel-membership", function () {

        showConfirm("Üyeliğinizi iptal etme işlemine devam etmek istediğinize emin misiniz?", function () {
            var token = getRequestToken();
            $.ajax({
                type: "POST",
                url: "/MemberTransaction/CancelMemberShip",
                data: { __RequestVerificationToken: token },
                success: function (data) {
                    if (IsNullOrUndefined(data) || data == "") {
                        const args = "True";
                        showMessage("Üyelik iptal işleminiz gerçekleştirilmiştir. Giriş yapmak isterseniz tekrar kayıt olmanız gerekmektedir.");
                        setTimeout(function () {
                            window.location.reload();
                        }, 2000);

                    }
                    else {
                        showMessage(data);
                    }
                }
            });
        },
            function () {
                return false;
            })

    });

}

