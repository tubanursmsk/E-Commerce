    $(function () {
        $(document).on("click", ".review-footer .comment_vote", function () {

            var $this = $(this);
            var _url = $this.attr("data-url");
            var type = $this.attr("data-type");
            var id = $this.attr("data-commentId");
            var isActive = $this.hasClass("active");



            if ($.cookie('userIDKey') !== undefined) {
                $.ajax({
                    type: "POST",
                    url: _url,
                    data: {
                        value: type,
                        ID: id
                    },
                    success: function () {
                        showMessage("Teşekkür Ederiz", "success");

                        if (isActive) {
                            $this.removeClass("active");
                        } else {
                            const oppositeType = type === "true" ? "false" : "true";
                            $(`.comment_vote[data-commentId="${id}"][data-type="${oppositeType}"]`).removeClass("active");
                            $this.addClass("active");
                        }
                    }
                });
            } else {
                showMessage("Yorum Beğenebilmek İçin Giriş Yapınız.");
            }
        });
    });

    CheckFavourites();
    function CheckFavourites() {
        if ($.cookie('userIDKey') !== undefined) {
            var dataid = parseInt($(".favoriteButton").attr("data-productId"), 10) || 0;

            if (dataid > 0) {
                var token = getRequestToken();
                $.ajax({
                    url: "/ProductDetail/CheckFavorites",
                    data: JSON.stringify({ productId: dataid }),
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    type: "Post",
                    success: function (data) {
                        if (data) {
                            $(".favoriteButton").addClass("active").addClass("isFavorite")
                            $("#favoriteButtonIcon").removeClass("icon-heart").addClass("icon-heart-alt").css("color", "#003277");
                            $(".icon-heart-alt").css("color", "#003277");
                        }
                        else {
                            $(".favoriteButton").removeClass("active").removeClass("isFavorite")
                            $("#favoriteButtonIcon").removeClass("icon-heart-alt").addClass("icon-heart").css("color", "")
                            $(".icon-heart-alt").css("color", "");
                        }

                    }
                });
            }
        }
    }


