Engine.contactForm = function () {

    var urlParams = new URLSearchParams(window.location.search);
    if (urlParams != null && urlParams.toString() != "") {
        document.getElementById("noneForm").classList.remove("hide");
        document.getElementById("form").classList.add("hide");
    }


};

Engine.payment = function () {
    // $(".nav-justified li").first().find("a").trigger("click");

    $("#cardnumber").keyup(function () {
        var myLength = $(this).val().length;
        if (myLength > 8) {
            $.ajax({
                url: $(this).attr("data-url"),
                data: { "bin": $(this).val() },
                success: function (data) {
                    $(".installments").html(data);
               //     $('input[name=installment]:first').attr('checked', true); //İlk taksit seçeneğini check'leyen js
               //     reloadBasketSummary();
                }
            });
        }
    });
    // Credit Function
    payCredit();
    paymentCartMp();

    $(".checkout-payment input").click(function () {
        if ($(this).attr("value") != "pay-with-card") {
            $(".threeD-section").hide();
        } else {
            $(".threeD-section").show();
        }
    });
    //#region submitPayment


    $("#submitPayment").click(function () {
        //InquireScore();
        if (validChc(".basket-ordersummary") == true) {
            if ($("#pay-with-card").hasClass("active")) {
                var userRewardAmount = "";
                if ($(".newCardPay .installments .checkout-payment__installment-list").attr("data-bank") == "Garanti") {
                    var rewardBNS = $('input[name=UserRewardAmountBNS]:checked').val();
                    var rewardFBB = $('input[name=UserRewardAmountFBB]:checked').val();
                    var userRewardAmount = !IsNullOrUndefined(rewardFBB) ? rewardFBB : "";
                    userRewardAmount += IsNullOrUndefined(rewardBNS) ? "" : ("-" + rewardBNS);
                }
                if (Valid() == undefined) {
                    locked();
                    var token = getRequestToken();
                    $.ajax({
                        url: $(this).attr("data-url"),
                        type: "POST",
                        data: {
                            "NameSurname": $("#cardholder").val(),
                            "CardNumber": $("#cardnumber").val(),
                            "Month": $("#cardexpiredatemonth").val(),
                            "Year": $("#cardexpiredateyear").val(),
                            "Cvc": $("#cardcvv2").val(),
                            "Installment": $('input[name=installment]:checked').val(),
                            "ThreeD": $('.threeD').is(':checked'),
                            "Aggrement": $('#aggrementButton').is(':checked'),
                            "MasterPass": $('#saveMyCard').is(':checked'),
                            "PhoneNumberPass": $('#phoneForMaster').val(),
                            "CardNamePass": $('#cardNameForMaster').val(),
                            "RegisteredCardNamePass": $('input[name=accountAliasName]:checked').attr("data-cardname"),
                            "CardNoPass": $('input[name=accountAliasName]:checked').attr("data-value"),
                            "CardUniqueIdPass": $('input[name=accountAliasName]:checked').attr("data-id"),
                            "BankIcaPass": $('input[name=accountAliasName]:checked').attr("data-bankica"),
                            "UserRewardAmount": userRewardAmount,
                            __RequestVerificationToken: token
                        },
                        success: function (data) {
                            if (data.masterpass) {
                                if (data.statu) {
                                    if (data.register) {
                                        $("#paymentform").empty();
                                        $("#paymentform").append(data.form);
                                        MFS.purchaseAndRegister($("#masterPassForm"), mfsResponseHandler);
                                        return false;
                                    } else {
                                        $("#paymentform").empty();
                                        $("#paymentform").append(data.form);
                                        MFS.purchase($("#masterPassForm"), mfsResponseHandler);
                                        return false;
                                    }

                                }
                            }
                            else if (data.threeD) {
                                if (data.statu) {
                                    if (data.httpPost) {

                                        $("body").append(data.form);
                                        downloadForm.submit();
                                        //$("#threeDSServerWebFlowStartForm").submit();

                                    }
                                    else {
                                        $("#paymentform").empty();
                                        $("#paymentform").append(data.form);
                                        $("#redirectForm").submit();
                                    }
                                }
                            } else {
                                if (data.statu) {
                                    location.href = data.redirect;
                                } else if (data.redirect !== "") {
                                    location.href = data.redirect;
                                } else {
                                    unlocked();
                                    showMessage(data.message);
                                }

                            }
                        }
                    });
                } else
                    showMessage(Valid());
            }
            else if ($("#pay-with-transfer").hasClass("active")) {
                var checkedBank = $('input[name=transfer-type]:checked').val();
                if (checkedBank !== undefined) {
                    if ($('input[name=transfer-type]:checked').val().indexOf("AKBANK") !== -1) { akbankDirekt(false); }
                    else if ($('input[name=transfer-type]:checked').val().indexOf("FIBABANK") !== -1) { fibaBankPay(false); }
                    else {
                        locked();
                        var token = getRequestToken();
                        $.ajax({
                            url: $(this).attr("data-transferPay"),
                            type: "POST",
                            data: {
                                "BankIBAN": $('input[name=transfer-type]:checked').val(),
                                __RequestVerificationToken: token
                            },
                            success: function (data) {
                                if (data.statu) {
                                    location.href = data.redirect;
                                } else {
                                    unlocked();
                                    showMessage(data.message, "error", data.redirect);
                                }
                            }
                        });
                    }

                } else
                    showMessage("Banka Seçimi Yapınız.");
            }
            else if ($("#pay-with-digitalbanks").hasClass("active")) {

                if ($('#bkm').is(':checked')) {
                    $.ajax({
                        type: 'GET',
                        url: '/Payment/ReInitTicket',
                        timeout: 10000,
                        beforeSend: locked(),
                        success: function (data) {
                            var ticket = JSON.parse(data);
                            bexInit(ticket);
                            unlocked();
                        }
                    });
                }
                else if ($('#akbankAxess').is(':checked')) {
                    locked();
                    $.ajax({
                        type: 'POST',
                        url: '/Payment/PayWithAxessMobile',
                        success: function (data) {
                            location.href = data;
                        }
                    });
                }
                else if ($('#garantiPay').is(':checked')) {
                    locked();
                    $.ajax({
                        type: 'POST',
                        url: '/Payment/PayWithGarantiPay',
                        success: function (data) {
                            $("#paymentform").empty();
                            $("#paymentform").append(data);
                            showConfirm("GARANTİ PAY İŞLEMLERİNDE GARANTİ UYGULAMASINDA ÖDEME ÇEKİLDİKTEN SONRA, VATAN BİLGİSAYAR UYGULAMASI VEYA WEB SİTESİ İÇERİSİNDE SİPARİŞ SONUÇLANDI SAYFASINA YÖNLENMEDEN <strong>VATAN BİLGİSAYAR SAYFASINI (VATAN BİLGİSAYAR UYGULAMASINI) KAPATMAYINIZ. YA DA GERİ TUŞUNA BASMAYINIZ</strong>!", function () {
                                $("#redirectForm").submit();
                            },
                                function () {
                                    unlocked();
                                    return false;
                                });
                        }
                    });
                }
                else if ($('#wordPay').is(':checked')) {
                    locked();
                    $.ajax({
                        url: "/Payment/PayWithWorldPay/",
                        type: "POST",
                        success: function (data) {
                            if (data !== undefined) {
                                post('https://apm.yapikredi.com.tr/web/prePayment', { token: data, merchantLogoUrl: 'https://cdn.vatanbilgisayar.com/images/frontend/assets/vatanlogo.svg', technicalErrorReturnUrl: 'http://localhost:57003/' });
                            }
                            else
                                unlocked();
                        },
                        error: function (ajaxContext) {
                            unlocked();
                        }
                    });
                }
            }
            else if ($("#pay-with-credit").hasClass("active")) {
                if ($('#fibabankCredit').is(':checked')) {
                    fibaBankPay(true);
                }
                else if ($('#akbankCredit').is(':checked')) {
                    akbankDirekt(true);
                }
                else if ($('#yapıkrediCredit').is(':checked')) {
                    locked();
                    $.ajax({
                        url: "/Payment/PayWithYapıkrediCreditAndTransfer/",
                        type: "POST",
                        success: function (data) {
                            if (data !== undefined)
                                location.href = data;
                            else
                                unlocked();
                        },
                        error: function (ajaxContext) {
                            unlocked();
                        }
                    });
                }
                else if ($('#isbankasiCredit').is(':checked')) {
                    locked();
                    $.ajax({
                        url: "/Payment/PayWithIsBankCreditAndTransfer/",
                        type: "POST",
                        success: function (data) {
                            if (data !== undefined)
                                location.href = data;
                            else
                                unlocked();
                        },
                        error: function (ajaxContext) {
                            unlocked();
                        }
                    });
                }
                else if ($('#garantiCredit').is(':checked')) {
                    locked();
                    $.ajax({
                        url: "/Payment/PayWithGarantiCreditAndTransfer/",
                        type: "POST",
                        success: function (data) {
                            if (data !== undefined)
                                location.href = data;
                            else
                                unlocked();
                        },
                        error: function (ajaxContext) {
                            unlocked();
                        }
                    });
                }
                else if ($('#masterCredit').is(':checked')) {
                    locked();
                    sendMasterPass();

                }
                else
                    showMessage("Banka Seçimi Yapınız.");
            }

        }
    });

    //#endregion

    $(".payOptions li a").click(function () {
        var id = $(this).attr("href");;
        if ($(this).hasClass("bkmTab")) {
            $("#submitPayment").html('BKM Express İle Öde <span class="icon-angle-right"></span>');
        }
        else if ($(this).hasClass("multiplecard")) {
            $("#submitPayment").addClass("nobtn disabled");
        }
        else {
            $("#submitPayment").html('Siparişi Onayla <span class="icon-angle-right"></span>');
        }
        if (!$(this).hasClass("multiplecard")) {
            $("#submitPayment").removeClass("disabled");
        }
        if ($(id).find(".nobtn").length) {
            $("#submitPayment").addClass("disabled");
        }


    });

    function bexInit(ticket) {
        Bex.init(ticket, "modal", {
            container: "payment-dropin",
            buttonSize: [135, 70],
            skipButton: true,
            onCancel: function () {
                console.info("User canceled the payment");
            },
            onComplete: function (status) {
                if (status == "success") {
                    locked();
                    location.href = "/Payment/Completed/";
                } else {
                    unlocked();
                    showMessage("Hata Oluştu.");
                }
            }
        });
    }

    $("#pay-with-credit").click(function () {
        $.ajax({
            url: "/Payment/CompayInstallments",
            success: function (data) {
                $(".fibaInstallments").html(data);
            }
        });
    });



    $(document).on("click", ".checkout-payment__installment-list tr", function (e) {

        
        if ($(e.target).is("input")) return;

        let radio = $(this).find("input[name='installment']");

        if (radio.length) {
            radio.prop("checked", true).trigger("click"); 
        }
    });


    $(document).on("click", ".checkout-payment__installment-list input[name='installment']", function () {
        var pyId = $(this).attr("data-pyId");
        var oldimgSrc = $(this).attr("data-oldimg");
        var cbid = $(this).attr("data-cbid");
        var img = $(this).attr("data-img");
        reloadBasketSummary(pyId, oldimgSrc, cbid);
        $(".checkout-payment__installment-list img").attr('src', img);
    });


    function reloadBasketSummary(pyId, oldimgSrc, cbid) {
        locked();
        $.ajax({
            url: "/Payment/_GetSummarywithInstallment/",
            data: {
                pyid: pyId
            },
            type: "POST",
            success: function (data) {
                unlocked();
                $(".payment-summary .payment-summary-partial").html(data.summaryForPayment);
                $(".aggremantBasketSummary").html(data.summaryForAggremant);
                $(".aggrementButton").prop("checked", false);

            }
        });

        //finans pesin ikon değiştirme
        //if (pyId == 70 && cbid==2) {
        //    $(".checkout-payment__installment-list img").attr('src', 'https://cdn.vatanbilgisayar.com/Upload/BANKA/3/3.png');
        //}
        //else if (cbid == 1) {
        //    $(".checkout-payment__installment-list img").attr('src', oldimgSrc);
        //}
    }

    $(".payOptions li a").click(function () {
        if ($(this).attr("data-type") != "creditCard" && $('input[name=installment]:checked').val() > 1) {
            reloadBasketSummary(0);
            $('input[name=installment]').prop("checked", false);
        }
    })

    //#region Garanti bonus ile ödeme
    $('.newCardPay input[type=text]').each(function () {
        $(this).change(function () {
            bonusCardControl();
        });
    });
    $(document).on("change", ".newCardPay select", function () {
        bonusCardControl();
    });
    $(document).on("change", "#saveMyCard", function () {
        if ($(this).is(':checked')) {
            $("#userRewardArea").addClass("hide");
        }
        else {

            bonusCardControl();
        }
    });
    function bonusCardControl() {

        if ($(".newCardPay .installments .checkout-payment__installment-list").attr("data-bank") == "Garanti" && !$(".newCardPay .card-entry-main").hasClass("hide") && !$('#saveMyCard').is(':checked')) {
            var cardNumber = $("#cardnumber").val();
            var cardHolder = $("#cardholder").val();
            var month = $('select[name=cardexpiredatemonth] option').filter(':selected').val();
            var year = $('select[name=cardexpiredateyear] option').filter(':selected').val();
            var cvc = $("#cardcvv2").val();
            if (cardNumber.length == 16 && cardHolder.length > 2
                && month != ""
                && year != "" && cvc.replaceAll('_', '').length == 3) {
                var token = getRequestToken();
                $.ajax({
                    url: "/Payment/UserReward",
                    data: {
                        'cardNumber': cardNumber,
                        'cardHolder': cardHolder,
                        'month': month,
                        'year': year,
                        'cvc': cvc,
                        __RequestVerificationToken: token,
                    },
                    type: "POST",
                    success: function (data) {
                        $(".newCardPay form #userRewardArea").remove();
                        $(".newCardPay form").append("<div id='userRewardArea' style='padding:10px;'></div>")
                        if (!IsNullOrUndefined(data.FBBAmount) && parseFloat(data.FBBAmount) > 0) {
                            $(".newCardPay form #userRewardArea").append('<div class="form-group"><label class="wrapper-checkbox"><input id="useUserRewardTotalAmountFBB" type="checkbox" name="UserRewardAmountFBB" value="FBB' + data.FBBAmount + '" >' +
                                ' <span class="checkmark"style="width: 19px;height:19px"></span><strong>' + data.FBBAmount + ' TL</strong> değerinde Vatan Bilgisayar bonusunuz var. Ödemenizde kullanmak ister misiniz? </label></div>');
                        }
                        if (!IsNullOrUndefined(data.BNSAmount) && parseFloat(data.BNSAmount) > 0) {
                            $(".newCardPay form #userRewardArea").append('<div class="form-group"><label class="wrapper-checkbox"><input id="useUserRewardTotalAmountBNS" type="checkbox" name="UserRewardAmountBNS" value="BNS' + data.BNSAmount + '" >' +
                                ' <span class="checkmark" style="width: 19px;height:19px"></span><strong>' + data.BNSAmount + ' TL</strong> değerinde bonusunuz var. Ödemenizde kullanmak ister misiniz? </label></div>');

                        }
                    }
                });
            }
        }
        else {
            $(".newCardPay form #userRewardArea").remove();
        }
    }

    //#endregion


    $('.threeD').change(function () {
        let threeD = $('.threeD').is(':checked');
        if (threeD == false) {
            alert("3D siz verilen siparişlerde güvenliğiniz için teyit almamız gerekebilir ve siparişin gönderim süresi uzayabilir. Siparişinizin daha hızlı size ulaşması için 3D Secure kullanarak sipariş vermenizi öneririz.");
        }
    });
};




Engine.degisTokusPage = function () {

    $(document).ready(GetBuyBackItemList());

    function GetBuyBackItemList() {
        $.ajax({
            url: "/Landing/GetBuyBackItemList/",
            type: "POST",
            success: function (data) {

                function renderProducts(products, tbodySelector) {
                    products.forEach(function (product) {
                        var productHTML = `
            <div class="tr row2">
                <p class="product-copy">${product.ModelName}</p>
                <p class="pricing-copy">${product.Amount} TL’ye kadar</p>
            </div>
        `;
                        $(tbodySelector).append(productHTML);
                    });
                }

                function PhoneProduct() {
                    if (!data || !data.BuybackProducts) return;

                    var applePhoneProducts = data.BuybackProducts.filter(function (product) {
                        return product.BrandName === "Apple" && product.ProductGroupName === "Cep Telefonu";
                    });

                    var preferredOrder = [
                        "iPhone 11 64 GB", "iPhone 12 64 GB", "iPhone 13 128 GB",
                        "iPhone 14 128 GB", "iPhone 15 256 GB", "iPhone 15 Pro 256 GB",
                        "iPhone 15 Pro 512 GB"
                    ];

                    applePhoneProducts.sort(function (a, b) {
                        var indexA = preferredOrder.indexOf(a.ModelName) === -1 ? preferredOrder.length : preferredOrder.indexOf(a.ModelName);
                        var indexB = preferredOrder.indexOf(b.ModelName) === -1 ? preferredOrder.length : preferredOrder.indexOf(b.ModelName);
                        return indexA - indexB;
                    });

                    var nonApplePhoneProducts = data.BuybackProducts.filter(function (product) {
                        return product.BrandName !== "Apple" && product.ProductGroupName === "Cep Telefonu";
                    });

                    nonApplePhoneProducts.sort(function (a, b) {
                        return (b.Amount || 0) - (a.Amount || 0);
                    });

                    var top7ApplePhoneProducts = applePhoneProducts.slice(0, 7);
                    var top7NonApplePhoneProducts = nonApplePhoneProducts.slice(0, 7);

                    renderProducts(top7ApplePhoneProducts, '#iphone-content .content-1 .tbody');
                    renderProducts(top7NonApplePhoneProducts, '#iphone-content .content-2 .tbody');
                }

                function macProduct() {
                    if (!data || !data.BuybackProducts) return;

                    var appleMacProducts = data.BuybackProducts.filter(function (product) {
                        return product.BrandName === "Apple" && product.ProductGroupName === "Mac";
                    });

                    appleMacProducts.sort(function (a, b) {
                        return b.Amount - a.Amount;
                    });

                    var top7AppleMacProducts = appleMacProducts.slice(0, 7);

                    renderProducts(top7AppleMacProducts, '#mac-content .content-1 .tbody');
                }

                PhoneProduct();
                macProduct();


            }
        });
    }
}

