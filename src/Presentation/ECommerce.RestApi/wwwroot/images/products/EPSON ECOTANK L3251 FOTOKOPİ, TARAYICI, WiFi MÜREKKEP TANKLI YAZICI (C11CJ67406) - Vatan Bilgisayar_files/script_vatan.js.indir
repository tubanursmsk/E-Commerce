            commentsData = calculateNewStatsAfterFilers(commentsData)
                    updateScoreArea(commentsData);
                    //document.querySelectorAll('.star-option')[0].click()
                    getContextAllFilterValues(commentsData.reviews)
                    getGeneralRatings(commentsData)
                    
                    if (!hasSeen && commentsData.reviews.length > 0) {
                        hasSeen = true;
                        goCommentTabClickEvent()

                    }

                    observeAverageRank(commentsData)
                    checkElement(commentsData)

        });
        aElement.classList.add('gen3-comment-point', 'gen3-star-center');
        aElement.innerHTML = `<div class="total-vote stars" style="margin-top: 0px; display: flex; margin-bottom: 0px; align-items: baseline;">
            <span class="ttl" style="margin-right:5px; font-size:14px; padding-top:2px;"></span>
