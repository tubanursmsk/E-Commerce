    //#region Question

    function getProductInfo(imageElementLocation, titleElementLocation) {

        
        let productDetail = document.getElementById('product-detail-gen3')
        productDetail.innerHTML = `
            <div id="soruDivId" class="sorudivid" style="display:block; margin: 5px auto;text-align: center; font-family: 'Plain', sans-serif;">
            <div class="comment-header-container">
            <h3 class="comment-header" style="text-align:center;
            color: black;
            font-size: 20px;
            font-family: arimo,sans-serif;
            line-height: 44px;
            font-weight: 400;
            word-wrap: break-word">Ürün Soruları</h3>
            
            `;
    }

    function renderQuestions(commentsData, paginationCount) {

        moreButton = document.getElementById('more-questions-button');
        renderedElementCount = document.getElementsByClassName('questions3g').length;
        startIndex = renderedElementCount;
        if ((commentsData.questions.length - renderedElementCount) <= paginationCount) {
            endIndex = renderedElementCount + commentsData.questions.length - renderedElementCount;
            //disable button
            moreButton.style.display = 'none';
        }
        else {
            endIndex = renderedElementCount + paginationCount;
            moreButton.style.display = 'block';
        }

        

        createQuestionElement_vatan(startIndex, endIndex, commentsData);
    }

    function createQuestionElement(startIndex, endIndex, commentsData) {
        questionsContainer = document.getElementById('question-container');
        for (let i = startIndex; i < endIndex; i++) {


            const questionElement = document.createElement('div');
            questionElement.classList.add('questions3g');
            if (commentsData.questions[i]) {
                questionElement.innerHTML = `
            <div class="question" style="text-align: left; margin: 10px auto; border: 1px solid #d3d3d3;border-radius: 5px;">
            <div style="padding:5px 15px; color:#0000007a;">
             <div style="color:#999;font-size: 14px;font-weight: 400;">***** ***** &middot; ${commentsData.questions[i].creationDate}</div>
             <div style="color:black; padding-block:10px; font-size:14px;">${commentsData.questions[i].text}</div>
             
            </div>
             <div style="background-color: #D9D9D9;  padding: 5px 15px; display: flex;border-radius: 0px 0px 5px 5px;align-items: center;">
                 <img style="width: 39px; border-radius:45px;" src="https://cdn.gocomment.io/gocomment/assets/vatan.jpg" alt="">
                <span style="margin-left:10px; font-size:14px">${commentsData.questions[i].answer.text}</span>
             </div>
         </div>
       `;

            }
            questionsContainer.appendChild(questionElement);
        }
    }

    function createQuestionElement_vatan(startIndex, endIndex, commentsData) {
        const questionsContainer = document.getElementById('question-container');
    
        for (let i = startIndex; i < endIndex; i++) {
            
            const question = commentsData.questions[i];
            const answer = question.answer;
    
            const questionElement = document.createElement('div');
            questionElement.classList.add('questions3g');

            let personName = `${question.userName[0]}********`

            if (question.is_nat) {
                personName = question.userName
            }
    
            questionElement.innerHTML = `



<div class="review-container" data-rank="5" data-confirm="False" data-photo="">
    <div class="user-info-container">
        <div class="user-info">
            <div class="user-icon">
                <!--?xml version="1.0" encoding="utf-8" ?-->
                <svg width="20px" height="20px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM6 8a6 6 0 1 1 12 0A6 6 0 0 1 6 8zm2 10a3 3 0 0 0-3 3 1 1 0 1 1-2 0 5 5 0 0 1 5-5h8a5 5 0 0 1 5 5 1 1 0 1 1-2 0 3 3 0 0 0-3-3H8z"
                        fill="#003177"></path>
                </svg>
            </div>
            <div class="user-name">
                <span>${personName}</span>
            </div>
        </div>
        <div class="review-date">${question.creationDate}</div>
    </div>
    <div class="review-content">

        <div class="review-text">
            ${question.text}
        </div>
        ${
            (question.likes || question.dislikes) ? `
        <div class="review-footer">
        ${question.likes ? `
            <div class="icon">
                <span data-type="true" data-url="/ProductDetail/AppraiseTheComment" data-commentid="${question.id}"
                    href="javascript:void(0)" class="comment_vote">

                    <!--?xml version="1.0" encoding="utf-8" ?-->
                    <!-- License: CC Attribution. Made by Saeedworks: https://dribbble.com/saeedworks -->
                    <svg width="20px" height="20px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <g id="style=linear">
                            <g id="like">
                                <path id="vector"
                                    d="M7.66003 10.1022L11.76 4.00221C12.16 3.40221 13.16 3.00221 13.96 3.30221C14.86 3.60221 15.46 4.60221 15.26 5.50221L14.76 8.70221C14.66 9.40221 15.16 9.90221 15.76 9.90221H19.76C21.26 9.90221 22.1801 11.0522 21.66 12.5022C21.14 13.9522 20.6801 16.5522 19.26 18.8022C18.6102 19.8318 17.8975 20.5522 16.6801 20.5522C12.6801 20.5522 6.66003 20.5522 6.66003 20.5522"
                                    stroke="#000" stroke-width="1" stroke-miterlimit="10"></path>
                                <path id="rec"
                                    d="M2.18005 10.5522C2.18005 9.99996 2.62777 9.55225 3.18005 9.55225H6.68005C7.23234 9.55225 7.68005 9.99996 7.68005 10.5522V20.5522H3.18005C2.62777 20.5522 2.18005 20.1045 2.18005 19.5522V10.5522Z"
                                    stroke="#000" stroke-width="1"></path>
                            </g>
                        </g>
                    </svg>



                    (${question.likes})

                </span>
            </div>
            ` : ''}
            ${question.dislikes ? `
            <div class="icon">
                <span data-type="false" data-url="/ProductDetail/AppraiseTheComment" data-commentid="${question.id}"
                    href="javascript:void(0)" class="dont-like comment_vote">


                    <!--?xml version="1.0" encoding="utf-8" ?-->
                    <!-- License: CC Attribution. Made by Saeedworks: https://dribbble.com/saeedworks -->
                    <svg width="20px" height="20px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                        class="icon-like">
                        <g id="style=linear">
                            <g id="like">
                                <path id="vector"
                                    d="M7.66003 10.1022L11.76 4.00221C12.16 3.40221 13.16 3.00221 13.96 3.30221C14.86 3.60221 15.46 4.60221 15.26 5.50221L14.76 8.70221C14.66 9.40221 15.16 9.90221 15.76 9.90221H19.76C21.26 9.90221 22.1801 11.0522 21.66 12.5022C21.14 13.9522 20.6801 16.5522 19.26 18.8022C18.6102 19.8318 17.8975 20.5522 16.6801 20.5522C12.6801 20.5522 6.66003 20.5522 6.66003 20.5522"
                                    stroke="#000" stroke-width="1" stroke-miterlimit="10"></path>
                                <path id="rec"
                                    d="M2.18005 10.5522C2.18005 9.99996 2.62777 9.55225 3.18005 9.55225H6.68005C7.23234 9.55225 7.68005 9.99996 7.68005 10.5522V20.5522H3.18005C2.62777 20.5522 2.18005 20.1045 2.18005 19.5522V10.5522Z"
                                    stroke="#000" stroke-width="1"></path>
                            </g>
                        </g>
                    </svg>


                    (${question.dislikes})

                </span>
            </div>
            ` : ''}
        </div>
        ` : ''
                }


            ${answer ? `
        <div class="reply-container">
            <div class="reply-user-icon">
                <img src="https://cdn.vatanbilgisayar.com/UPLOAD/BANNER/0banner/2025/004/40x40logo.png"
                    alt="Vatan Logo">
            </div>
            <div class="reply-content">
                <div>
                    <span class="reply-username">Vatan Bilgisayar</span>
                    <span class="reply-date">
                        ${answer.creationDate} </span>
                </div>
                <div class="reply-text">
                    ${answer.text}
                </div>
            </div>
        </div>
        ` : ''}

    </div>

</div>

`;

    
            questionsContainer.appendChild(questionElement);
        }
    }
    

