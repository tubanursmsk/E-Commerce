            <span style="font-size:14px; padding-left:2px;" class="total-comment-number"></span>
            <span><img ${GOSETTINGS['is_photo_active'] ? '' : 'hidden'} id="questionCheckImg" style="width:15px;margin-left: 6px;" src="https://cdn.gocomment.io/gocomment/assets/T1esg3R8P7eptg.png"></span>
            <span id="questionCheckTotal" style="font-size: 14px; margin-left: 5px;" class="total-question"></span><br>
        </div>`;



        if (commentsData.favoriteCount && GOSETTINGS['is_favcount_active']) {
            aElement.innerHTML += `<div class="total-vote favs" style="margin-top: 0px; display: flex; margin-bottom: 10px; align-items: center; font-size:16px; justify-content:center;">
            ❤️ ${commentsData.favoriteCount} kişi favorilere ekledi
