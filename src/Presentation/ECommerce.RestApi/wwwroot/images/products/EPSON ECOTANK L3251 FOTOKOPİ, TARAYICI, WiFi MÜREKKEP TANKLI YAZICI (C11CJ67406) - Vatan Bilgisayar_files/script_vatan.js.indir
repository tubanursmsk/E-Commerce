    function checkElement(commentsData) {
        let attemptCount = 0;
        const maxAttempts = 6;
    
        const intervalId = setInterval(function() {
            attemptCount++;
            
            var element = document.getElementsByClassName('comment-items');
    
            if (element.length > 0) {
                var loadEle = document.getElementsByClassName('loadMoreCommet')[0];
                loadEle.style.display = 'none';
                var existContainer = document.getElementById('itemContainer');
                existContainer.innerHTML = "";
            }
            
            if (attemptCount >= maxAttempts) {
                clearInterval(intervalId); // 3 denemeden sonra interval'ı temizler
            }
        }, 500); // Her 500 ms'de bir çalışacak
    }
    
    function observeAverageRank(commentsData) {
        let attemptCount = 0;
        const maxAttempts = 6;
        
        const intervalId = setInterval(function() {
            attemptCount++;
            
            var averageRankElement = document.getElementById('averageRankNum');
            
            if (averageRankElement) {
                updateScoreArea(commentsData);
            }
            
            if (attemptCount >= maxAttempts) {
                clearInterval(intervalId);
            }
        }, 500); 
    }

    function customDelay(milliseconds) {
        return new Promise(resolve => setTimeout(resolve, milliseconds));
    }

