                </select>
        </div>
      
        </div>
    `;




    }
    // Function to create style element
    function createStyle(starColor) {
        createResponsiveStyle();
        const style = document.createElement('style');
        style.textContent = `
        .recommend-headertext{
            color: black;
font-size: 14px;
font-family: 'Plain', sans-serif;
font-weight: 600;
line-height: 22px;
word-wrap: break-word
        }
