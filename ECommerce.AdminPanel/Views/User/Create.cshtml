@model ECommerce.AdminPanel.Models.User.UserCreateViewModel
@{
    ViewData["Title"] = "Yeni Personel Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0" style="border-radius: 15px;">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h3 class="fw-bold mb-0 text-primary"><i class="fas fa-user-plus me-2"></i>Yeni Personel Kaydı</h3>
                <p class="text-muted small">Sisteme erişimi olacak yeni kullanıcı bilgilerini tanımlayın.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-bold"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Ad">
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-bold"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Soyad">
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" placeholder="personel@sirket.com">
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <input asp-for="Password" class="form-control" placeholder="******">
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-bold">Yetki Rolü</label>
                            <select asp-for="Role" class="form-select">
                                <option value="Staff">Staff (Personel)</option>
                                @if (User.IsInRole("Admin"))
                                {
                                    <option value="CompanyManager">Company Manager</option>
                                    <option value="Admin">System Admin</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4 py-2 flex-grow-1" style="background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%); border:none;">
                                <i class="fas fa-save me-2"></i>Kaydı Tamamla
                            </button>
                            <a asp-action="Index" class="btn btn-light px-4 py-2 border">İptal</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}