@model IEnumerable<ECommerce.Application.DTOs.User.UserDto>
@{
    ViewData["Title"] = "Personel ve Kullanıcı Yönetimi";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title">Kullanıcı Yönetimi</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-user-plus me-2"></i>Yeni Personel Ekle
    </a>
</div>

<div class="card shadow-sm border-0" style="border-radius: 15px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Ad Soyad</th>
                        <th>E-Posta</th>
                        <th>Rol</th>
                        <th class="text-center">Durum</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                                        @user.FirstName[0]@user.LastName[0]
                                    </div>
                                    <span class="fw-bold">@user.FirstName @user.LastName</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">
                                    @user.Role
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(user.Status ? "bg-success" : "bg-danger")">
                                    @(user.Status ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-center">
                                 <a asp-action="Update" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary border-0">
                                    <i class="fas fa-user-edit"></i>
                                </a>
                                
                                @if (user.Role != "Admin") // Admin'in silinmesini engelleyelim
                                {
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Kullanıcıyı silmek istediğinize emin misiniz?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                            <i class="fas fa-user-minus"></i>
                                        </button>
                                    </form>
                                }
                                
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>