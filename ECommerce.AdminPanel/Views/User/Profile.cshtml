@model ECommerce.AdminPanel.Models.User.UserProfileViewModel
@{
    ViewData["Title"] = "Profilim";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 overflow-hidden" style="border-radius: 15px;">
            <div class="bg-primary p-5 text-center text-white" style="background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%);">
                <div class="avatar-xl bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px; font-size: 2.5rem; border: 4px solid rgba(255,255,255,0.2);">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>
                <h3 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h3>
                <span class="badge bg-light text-primary mt-2">@Model.Role</span>
            </div>

            <div class="card-body p-5">
                <form asp-action="Profile" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-bold"></label>
                            <input asp-for="FirstName" class="form-control form-control-lg">
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-bold"></label>
                            <input asp-for="LastName" class="form-control form-control-lg">
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control form-control-lg">
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-5 d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg px-5 flex-grow-1 shadow" style="border-radius: 10px;">
                                <i class="fas fa-user-check me-2"></i>Değişiklikleri Kaydet
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-lg px-4" style="border-radius: 10px;" onclick="location.href='/Home/Index'">
                                İptal
                            </button>
                        </div>
                    </div>
                </form>

                <hr class="my-5">

                <div class="d-flex align-items-center justify-content-between p-4 bg-light rounded-3">
                    <div>
                        <h6 class="fw-bold mb-1">Hesap Güvenliği</h6>
                        <p class="text-muted small mb-0">Şifrenizi düzenli aralıklarla değiştirmeniz önerilir.</p>
                    </div>
                    <a href="#" class="btn btn-sm btn-warning fw-bold px-3">
                        <i class="fas fa-lock me-2"></i>Şifre Değiştir
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>